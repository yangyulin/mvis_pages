---
// "In one table": measured t_ga, the share of an injected delay each one-clock tool puts into td, and the predicted
// against the measured raw-bag td gap (tool − MVIS, signed, per camera). Every number from tga.json.
import data from '../data/tga/tga.json';

const L: any = (data as any).devices.looper, T: any = (data as any).devices.t265;
const f = (v: number, d = 2) => (v > 0 ? '+' : v < 0 ? '−' : '') + Math.abs(v).toFixed(d);
const pair = (v: number[]) => v.map((a) => f(a)).join(' / ');
---
<table>
  <thead><tr><th>Result</th><th>{L.label}</th><th>{T.label}</th></tr></thead>
  <tbody>
    <tr><td>Recording</td><td>{L.recording}</td><td>{T.recording}</td></tr>
    <tr><td>t_ga on the raw bag (MVIS)</td><td><b>{f(L.raw.mvis_tga)} ± {L.raw.mvis_tga_sigma.toFixed(2)}</b></td><td><b>{f(T.raw.mvis_tga)} ± {T.raw.mvis_tga_sigma.toFixed(2)}</b></td></tr>
    <tr><td>Share of an injected delay in Kalibr td</td><td><b>{L.slope.kalibr.toFixed(2)}</b></td><td><b>{T.slope.kalibr.toFixed(2)}</b></td></tr>
    <tr><td>Share in Basalt td</td><td><b>{L.slope.basalt.toFixed(2)}</b></td><td><b>{T.slope.basalt.toFixed(2)}</b></td></tr>
    <tr><td>Kalibr − MVIS td, predicted (share × t_ga)</td><td>{f(L.gap.kalibr_predicted)}</td><td>{f(T.gap.kalibr_predicted)}</td></tr>
    <tr><td>Kalibr − MVIS td, measured, cam0 / cam1</td><td><b>{pair(L.gap.kalibr)}</b></td><td><b>{pair(T.gap.kalibr)}</b></td></tr>
    <tr><td>Basalt − MVIS td, predicted</td><td>{f(L.gap.basalt_predicted)}</td><td>{f(T.gap.basalt_predicted)}</td></tr>
    <tr><td>Basalt − MVIS td, measured, cam0 / cam1</td><td><b>{pair(L.gap.basalt)}</b></td><td><b>{f(T.gap.basalt[0])}</b> / {f(T.gap.basalt[1])} ‡</td></tr>
  </tbody>
</table>
<p class="tga-foot">Times in ms. The gaps are differences from MVIS, not errors. ‡ Basalt fits one offset for the whole
  rig. The two T265 cameras differ by {Math.abs(T.raw.mvis_td[0] - T.raw.mvis_td[1]).toFixed(1)} ms in MVIS
  ({f(T.raw.mvis_td[0])} / {f(T.raw.mvis_td[1])}), so the Basalt gap is only like-for-like against cam0.</p>

<style>
  .tga-foot { font-size: 0.8rem; color: var(--rp-mut); }
</style>
