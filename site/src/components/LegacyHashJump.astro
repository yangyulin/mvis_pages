---
// Old deep links of the one-page results (/benchmark/results/#ds-virig, #rp-cav-virig-a, #rp-T6-gyro, and the same
// via the /benchmark/leaderboard/ redirect) go to the top of that dataset's eval page: its repeatability ids are off
// the page since 2026-11-11 (coverage and parameters only). Any other hash (#ds-overall, #ov-h included) stays on this page. Fed by results-nav.json[].legacy.
import nav from '../data/results-nav.json';
const map: Record<string, string> = {};
for (const p of nav) for (const h of p.legacy) map[h] = p.link;
---
<script is:inline define:vars={{ map }}>
  const to = map[decodeURIComponent(location.hash.slice(1))];
  if (to) location.replace(to);
</script>
