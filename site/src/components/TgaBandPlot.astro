---
// T265 accel-minus-gyro delay per motion band (not a pure shift), with the solver's single t_ga as a line.
// Bands at or above uncertain_from_hz have low coherence: open markers, dashed segment. Data from tga.json.
import data from '../data/tga/tga.json';

const b: any = (data as any).t265_bands;
const solver: number = (data as any).devices.t265.raw.mvis_tga;
const W = 420, H = 210, L = 44, R = 14, T = 12, B = 36;
const n = b.delay_ms.length;
const x = (i: number) => L + ((i + 0.5) / n) * (W - L - R);
const lo = -8, hi = 0;
const y = (v: number) => T + ((hi - v) / (hi - lo)) * (H - T - B);
const yt = [-8, -6, -4, -2, 0];
const weak = (i: number) => b.bands_hz[i][0] >= b.uncertain_from_hz;
const f = (v: number) => (v < 0 ? '−' : '') + Math.abs(v).toFixed(2);
const firm = b.delay_ms.map((v: number, i: number) => [i, v]).filter(([i]: number[]) => !weak(i));
const last = firm[firm.length - 1][0];
const seg = (pts: number[][]) => pts.map(([i, v], k) => `${k ? 'L' : 'M'}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
const tail = b.delay_ms.map((v: number, i: number) => [i, v]).filter(([i]: number[]) => i >= last);
---
<figure class="rp-plot tga-band">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`T265 accel delay by motion band, from ${f(b.delay_ms[0])} ms at the lowest band to ${f(b.delay_ms[n - 1])} ms at the highest; the solver's single value is ${f(solver)} ms`}>
    {yt.map((t) => (
      <g>
        <line class="rp-grid" x1={L} x2={W - R} y1={y(t)} y2={y(t)} />
        <text class="rp-tick" x={L - 5} y={y(t) + 3} text-anchor="end">{t}</text>
      </g>
    ))}
    <line class="tga-solver" x1={L} x2={W - R} y1={y(solver)} y2={y(solver)} />
    <text class="rp-tick" x={W - R} y={y(solver) - 4} text-anchor="end">solver t_ga {f(solver)} ms</text>
    <path class="tga-bline" d={seg(firm)} />
    <path class="tga-bline tga-weak" d={seg(tail)} />
    {b.delay_ms.map((v: number, i: number) => (
      <g>
        <title>{`${b.bands_hz[i][0]}–${b.bands_hz[i][1]} Hz: delay ${f(v)} ms, gain ${b.gain[i].toFixed(2)}${weak(i) ? ' (low coherence, less certain)' : ''}`}</title>
        <circle class={weak(i) ? 'tga-bdot tga-open' : 'tga-bdot'} cx={x(i)} cy={y(v)} r="4.5" />
        <text class="rp-tick" x={x(i)} y={H - B + 14} text-anchor="middle">{b.bands_hz[i][0]}–{b.bands_hz[i][1]}</text>
      </g>
    ))}
    <text class="rp-tick" x={(L + W - R) / 2} y={H - 4} text-anchor="middle">motion band (Hz)</text>
    <text class="rp-tick" x="10" y={(T + H - B) / 2} text-anchor="middle" transform={`rotate(-90 10 ${(T + H - B) / 2})`}>accel − gyro delay (ms)</text>
  </svg>
  <figcaption>On the T265 the accel delay shrinks as the motion gets faster, so one t_ga is a compromise for the
    motion in the recording. Coherence falls above about {b.uncertain_from_hz} Hz, so the two open points are less certain.
    Hover a point for its gain.</figcaption>
</figure>

<style>
  .tga-band { max-width: 34rem; }
  .tga-bline { fill: none; stroke: var(--rp-mvis); stroke-width: 2; }
  .tga-weak { stroke-dasharray: 4 3; opacity: 0.7; }
  .tga-bdot { fill: var(--rp-mvis); stroke: var(--sl-color-bg); stroke-width: 1.5; }
  .tga-open { fill: var(--sl-color-bg); stroke: var(--rp-mvis); stroke-width: 1.8; }
  .tga-solver { stroke: var(--sl-color-gray-3); stroke-width: 1; stroke-dasharray: 5 3; }
</style>
