---
// One part of a sensor page. Each /devices/<device>.mdx is a thin wrapper that lists the parts, so headings reach the
// page's table of contents. Data and script are generated by site/scripts/export_sensors.py (python/mvis_site).
import '../data/sensors/sensor.css';

const all = import.meta.glob('../data/sensors/*.json', { eager: true }) as Record<string, { default: any }>;
interface Props { sensor: string; part: string }
const { sensor, part } = Astro.props;
const s = all[`../data/sensors/${sensor}.json`]?.default;
if (!s) throw new Error(`no sensor ${sensor}`);
const html = s.parts[part];
if (!html) throw new Error(`no part ${part} for ${sensor}`);
const data = JSON.stringify({ rigs: s.rigs, procs: s.procs, plotly: s.plotly }).replace(/</g, '\\u003c');
---

<div class="not-content sp" set:html={html} />
{(part === 'map' || part === 'rig') && <script type="application/json" id="sp-data" set:html={data} />}
<script src="../scripts/sensor-page.js"></script>
