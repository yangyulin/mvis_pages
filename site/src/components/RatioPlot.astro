---
// Spread ratio R = sd(first) / sd(second) per tool pair on a log axis 0.1-10, with the 95 % interval and the tie band
// 0.80-1.25 shaded. Rendered at build time; colours from currentColor and the tool tokens.
interface Props { pairs: any[] }
const pairs = Astro.props.pairs.filter((q: any) => q.R !== null);
const W = 420, L = 112, R = 14, top = 8, rowH = 26;
const H = top + rowH * pairs.length + 30;
const lo = Math.log10(0.1), hi = Math.log10(10);
const x = (v: number) => L + ((Math.log10(Math.min(10, Math.max(0.1, v))) - lo) / (hi - lo)) * (W - L - R);
const ticks = [0.1, 0.25, 0.5, 1, 2, 4, 10];
const out = (v: number | null) => v !== null && (v < 0.1 || v > 10);
const word = (q: any) => q.decision === 'a' ? `${q.a} tighter` : q.decision === 'b' ? `${q.b} tighter` : q.decision === 'tie' ? 'tie' : q.decision === 'too_few' ? 'too few recordings' : 'not compared';
---
{pairs.length > 0 && (
<figure class="rp-plot">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Spread ratio of each tool pair on a log scale, with 95 % intervals">
    <rect class="rp-band" x={x(0.8)} y={top - 4} width={x(1.25) - x(0.8)} height={rowH * pairs.length + 4} />
    {ticks.map((t) => (
      <g>
        <line class={t === 1 ? 'rp-one' : 'rp-grid'} x1={x(t)} x2={x(t)} y1={top - 4} y2={top + rowH * pairs.length} />
        <text class="rp-tick" x={x(t)} y={top + rowH * pairs.length + 14} text-anchor="middle">{t}</text>
      </g>
    ))}
    <text class="rp-tick" x={L} y={H - 2}>← first tool scatters less</text>
    <text class="rp-tick" x={W - R} y={H - 2} text-anchor="end">second tool scatters less →</text>
    {pairs.map((q: any, i: number) => {
      const y = top + rowH * i + rowH / 2;
      const tool = q.decision === 'a' ? q.a : q.decision === 'b' ? q.b : null;
      return (
        <g class="rp-row">
          <title>{`${q.a} ÷ ${q.b}: R = ${q.R}${q.ci ? `, 95 % interval ${q.ci[0] ?? 'not bounded'}–${q.ci[1] ?? 'not bounded'}` : ''} · ${word(q)}`}</title>
          <rect x="0" y={y - rowH / 2} width={W} height={rowH} fill="transparent" />
          <text class="rp-lab" x={L - 8} y={y + 4} text-anchor="end">{q.a} ÷ {q.b}</text>
          {q.ci && (
            <line class="rp-ci" x1={x(q.ci[0] ?? 0.1)} x2={x(q.ci[1] ?? 10)} y1={y} y2={y} />
          )}
          <circle class={`rp-dot ${tool ? `rp-t-${tool}` : 'rp-dot-neutral'}`} cx={x(q.R)} cy={y} r="5" />
          {out(q.R) && <text class="rp-tick" x={q.R < 0.1 ? x(0.1) - 10 : x(10) + 2} y={y + 4}>{q.R < 0.1 ? '◀' : '▶'}</text>}
        </g>
      );
    })}
  </svg>
  <figcaption>Ratio R of the two tools' typical scatter, first ÷ second. Shaded: 0.80–1.25, the gap treated as a tie
    even when it is clear. Bars: 95 % interval (not adjusted for multiple tests); a missing end is not bounded.
    Filled dots in a tool's colour mark a decided pair.</figcaption>
</figure>
)}
