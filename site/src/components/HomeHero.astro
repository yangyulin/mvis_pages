---
// Homepage hero (overrides Starlight's Hero, which only renders on pages with a
// `hero` frontmatter block — i.e. the landing page).
//
// Each MVIS calibration listed in rigs.json plays a 15 s real-time pass (rig flying its recovered
// trajectory, frustums, board corners in the colour of the camera shown in 3-D), then the next one.
// Layouts (plan: mira docs/plans/mvis/web-pages/homepage-responsive):
//   phone  (< 641 px)       title · 16:9 video (live camera baked into its corner) · CTA · chips · 3 readout values · Details
//   tablet (641–1099 px)    text | video (inset) · bar underneath · Details
//   wide   (≥ 1100 px)      text over the left of a contained, right-aligned loop · tile column sized from the
//                           available height · one-line bar; the whole hero fits the first viewport
// Media: public/media/hero/ — openmvis-internal demo_video/render_hero.py, render_hero_tiles.py and
// build_site_media.py (1920 px loop; 960 px loop with the live camera baked in; per-camera tiles 400 + 240 px).
// All encodes have a keyframe every second so companion seeks stay cheap on phones.
//
// Cache busting: every media URL carries a short content hash (?v=...) computed at build time.
import { readdirSync, readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';

// resolved from the project root (the bundled module lives elsewhere at build time)
const MEDIA_DIR = `${process.cwd()}/public/media/hero/`;
const V = {};
for (const f of readdirSync(MEDIA_DIR)) {
  V[f] = createHash('sha1').update(readFileSync(MEDIA_DIR + f)).digest('hex').slice(0, 10);
}
const u = (f) => `/media/hero/${f}?v=${V[f] ?? '0'}`;

const { rigs } = JSON.parse(readFileSync(MEDIA_DIR + 'rigs.json', 'utf8'));
const first = rigs[0];
const countWords = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const cycleLabel = `Cycling through ${countWords[rigs.length] ?? rigs.length} recordings`;
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,500..800&family=JetBrains+Mono:wght@400;500&display=swap" />

<section class="mh" aria-label="Open MVIS">
  <div class="mh-text">
    <div class="mh-eyebrow"><b>v0.1</b><span>Toolbox + public benchmark</span></div>
    <h1>OpenMVIS</h1>
    <p class="mh-sub">Open-source <em>multi-visual-inertial</em> <span class="mh-nw">system calibration</span></p>
    <div class="mh-actions">
      <a class="mh-btn mh-primary" href="/getting-started/quickstart/">Get started
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9m-3.5-3.5L12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </a>
      <a class="mh-btn mh-ghost" href="/benchmark/leaderboard/">Leaderboard</a>
      <a class="mh-btn mh-ghost" href="/examples/">Examples</a>
    </div>
  </div>

  <div class="mh-video">
    <div class="mh-frame" id="mhFrame">
      <video class="mh-main" id="mhVideo" muted playsinline preload="metadata" aria-hidden="true"
             poster={u(`hero_${first.key}_960.jpg`)}></video>
      <button class="mh-bigplay" id="mhBigPlay" type="button" hidden aria-label="Play the calibration video">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
      </button>
    </div>
  </div>

  <ul class="mh-tiles" id="mhTiles" aria-label="Detections in each camera"></ul>

  <div class="mh-cta-phone">
    <a class="mh-btn mh-primary" href="/getting-started/quickstart/">Get started
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9m-3.5-3.5L12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </a>
    <div class="mh-links"><a href="/benchmark/leaderboard/">Leaderboard</a><a href="/examples/">Examples</a></div>
  </div>

  <div class="mh-bar">
    <div class="mh-rigs">
      <span class="mh-label" id="mhRigsLabel">{cycleLabel}</span>
      <div class="mh-chips" id="mhChips" role="group" aria-labelledby="mhRigsLabel">
        {rigs.map((r, i) => (
          <button class="mh-chip" id={`mh-rig-${r.key}`} type="button" data-rig={r.key} aria-pressed={i === 0 ? 'true' : 'false'}>{r.chip}</button>
        ))}
      </div>
    </div>
    <dl class="mh-ro" aria-live="polite">
      <div><dt>Sensors</dt><dd data-k="sensors" set:html={first.sensors} /></div>
      <div><dt>Reproj median</dt><dd data-k="rms" set:html={first.rms} /></div>
      <div><dt>Window</dt><dd data-k="window" set:html={first.window} /></div>
      <div class="mh-x"><dt>Base cam offset</dt><dd data-k="td" set:html={first.td} /></div>
      <div class="mh-x"><dt data-k="xlabel" set:html={first.xlabel} /><dd data-k="xval" set:html={first.xval} /></div>
      <div class="mh-x"><dt>Corners / frame</dt><dd data-k="corners" set:html={first.corners} /></div>
    </dl>
    <button class="mh-play" id="mhPlay" type="button" aria-controls="mhVideo">Pause</button>
    <p class="mh-note"><span data-k="caption">{first.caption}</span> The outlined camera is the one shown in 3-D; the board corners it detects take its colour.</p>

    <details class="mh-more" id="mhMore">
      <summary>Details: all cameras and readout</summary>
      <dl class="mh-ro mh-ro-more">
        <div><dt>Base cam offset</dt><dd data-k="td" set:html={first.td} /></div>
        <div><dt data-k="xlabel" set:html={first.xlabel} /><dd data-k="xval" set:html={first.xval} /></div>
        <div><dt>Corners / frame</dt><dd data-k="corners" set:html={first.corners} /></div>
      </dl>
      <p class="mh-legend"><span data-k="caption">{first.caption}</span> Each camera has its own colour. The outlined camera is the one shown in 3-D, and the board corners it detects take that colour. In the camera views, coloured circles are detections and white crosses are reprojections.</p>
      <ul class="mh-strip" id="mhStrip"></ul>
    </details>
  </div>
</section>

<style is:global>
  html:has(.mh), html:has(.mh) body { overflow-x: clip; }

  .mh {
    --mh-night: #05070a;
    --mh-ink: #eef3f8;
    --mh-dim: #9aa9ba;
    --mh-rule: rgba(148, 163, 184, 0.22);
    --mh-sky: #38bdf8;
    --mh-amber: #ff9f1c;
    --mh-display: "Archivo", "Helvetica Neue", Arial, sans-serif;
    --mh-mono: "JetBrains Mono", var(--sl-font-mono, ui-monospace), monospace;
    --mh-gutter: clamp(16px, 3.5vw, 48px);
    --mh-side: var(--mh-gutter);

    position: relative;
    isolation: isolate;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-top: -1.5rem;
    background: var(--mh-night);
    color: var(--mh-ink);
    display: grid;
    padding-inline: var(--mh-side);
  }
  .mh :focus-visible { outline: 2px solid var(--mh-sky); outline-offset: 3px; border-radius: 3px; }
  .mh h1, .mh p, .mh dl, .mh ul { margin: 0; }
  .mh h1 { border-bottom: 0; padding-bottom: 0; color: var(--mh-ink); }

  /* ---- text ---- */
  .mh-text { min-width: 0; }
  .mh-eyebrow { font: 500 12px/1 var(--mh-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--mh-dim);
                display: flex; gap: 12px; align-items: center; margin-bottom: 18px; }
  .mh-eyebrow b { color: var(--mh-sky); font-weight: 500; }
  .mh h1 { font: 800 clamp(44px, 4.4vw, 88px)/0.92 var(--mh-display); font-stretch: 120%; letter-spacing: -0.035em; white-space: nowrap; }
  .mh .mh-sub { margin-top: 14px; color: #c9d4e0; font: 600 clamp(20px, 2vw, 32px)/1.15 var(--mh-display); font-stretch: 108%; letter-spacing: -0.012em; }
  .mh-sub em { font-style: normal; color: var(--mh-sky); white-space: nowrap; }
  .mh-nw { white-space: nowrap; }
  .mh-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .mh-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 0 18px; border-radius: 8px;
            font-weight: 600; font-size: 15px; line-height: 1; text-decoration: none; border: 1px solid transparent; }
  .mh-btn svg { width: 16px; height: 16px; }
  .mh-primary { background: var(--mh-sky); color: #04111c; }
  .mh-primary:hover { background: #7dd3fc; color: #04111c; }
  .mh-ghost { color: var(--mh-ink); border-color: var(--mh-rule); background: rgba(5, 7, 10, 0.35); }
  .mh-ghost:hover { border-color: var(--mh-dim); color: #fff; }

  /* ---- video ---- */
  .mh-video { min-width: 0; }
  .mh-frame { position: relative; width: 100%; aspect-ratio: 16 / 9; background: var(--mh-night); touch-action: manipulation; -webkit-user-select: none; user-select: none; }
  .mh-main { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; background: var(--mh-night); }
  .mh-bigplay { position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: 64px; height: 64px; border-radius: 50%;
                border: 1px solid var(--mh-rule); background: rgba(5, 7, 10, 0.7); color: var(--mh-ink); display: grid; place-items: center; cursor: pointer; }
  .mh-bigplay[hidden] { display: none; }
  .mh-bigplay svg { width: 28px; height: 28px; margin-left: 3px; }

  /* ---- tiles (wide) and strip (Details) ---- */
  .mh-tiles, .mh-strip { list-style: none; padding: 0; }
  .mh-tiles li, .mh-strip li { margin: 0; }
  .mh-tile { margin: 0; border: 1px solid var(--mh-rule); border-radius: 7px; overflow: hidden; background: rgba(5, 7, 10, 0.72);
             transition: border-color 0.3s ease, box-shadow 0.3s ease; }
  .mh-tile figcaption { display: flex; align-items: center; gap: 7px; padding: 5px 8px; font: 500 11px/1.2 var(--mh-mono); color: var(--mh-dim);
                        white-space: nowrap; overflow: hidden; }
  .mh-tile figcaption i { width: 7px; height: 7px; border-radius: 2px; background: var(--cam); flex: none; }
  .mh-tile figcaption b { color: var(--mh-ink); font-weight: 500; }
  .mh-tile figcaption span { overflow: hidden; text-overflow: ellipsis; }
  .mh-tile figcaption em { margin-left: auto; font-style: normal; font-size: 9.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--cam);
                           opacity: 0; transition: opacity 0.3s ease; }
  .mh-tile video { display: block; width: 100%; height: auto; max-width: 100%; background: var(--mh-night); }
  .mh-tile.live { border-color: var(--cam); box-shadow: 0 0 0 1px var(--cam); }
  .mh-tile.live figcaption em { opacity: 1; }
  .mh .mh-strip { display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 8px; margin-top: 12px; }

  /* ---- bar ---- */
  .mh-bar { border-top: 1px solid var(--mh-rule); display: grid; gap: 12px 28px; align-items: center; padding-block: 14px; min-width: 0; }
  .mh-rigs { display: grid; gap: 8px; min-width: 0; }
  .mh-label, .mh-ro dt { font: 500 10.5px/1 var(--mh-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--mh-dim); }
  .mh-chips { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; scroll-snap-type: x proximity; }
  /* the fade only exists while the row really is wider than its box (JS sets .is-over) */
  .mh-chips.is-over { padding-right: 28px;
              -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 36px), transparent); mask-image: linear-gradient(90deg, #000 calc(100% - 36px), transparent); }
  /* at the end of the strip there is nothing more to hint at, and the last name must be readable */
  .mh-chips.is-over.at-end { -webkit-mask-image: none; mask-image: none; }
  .mh-chips::-webkit-scrollbar { display: none; }
  .mh-chip { flex: none; scroll-snap-align: start; font-size: 13px; font-weight: 500; line-height: 1; color: var(--mh-dim); background: transparent;
             border: 1px solid var(--mh-rule); border-radius: 999px; padding: 0 13px; min-height: 36px; cursor: pointer; white-space: nowrap; }
  .mh-chip:hover { color: var(--mh-ink); border-color: var(--mh-dim); }
  .mh-chip[aria-pressed="true"] { color: #04111c; background: var(--mh-ink); border-color: var(--mh-ink); }
  .mh-ro { display: grid; gap: 10px 22px; transition: opacity 0.25s ease; min-width: 0; }
  .mh-ro.swap { opacity: 0; }
  .mh-ro div { min-width: 0; }
  .mh-ro dt { display: flex; align-items: center; gap: 6px; white-space: nowrap; overflow: hidden; }
  .mh-ro dt::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--mh-amber); flex: none; }
  .mh-ro dd { margin: 6px 0 0; font: 500 15px/1.2 var(--mh-mono); font-variant-numeric: tabular-nums; color: var(--mh-ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mh-ro dd small { color: var(--mh-dim); font-size: 12px; }
  .mh-play { font: 500 12px/1 var(--mh-mono); color: var(--mh-dim); background: none; border: 1px solid var(--mh-rule); border-radius: 6px;
             min-height: 36px; padding: 0 12px; cursor: pointer; letter-spacing: 0.06em; justify-self: end; }
  .mh-play:hover { color: var(--mh-ink); }
  .mh-note { font-size: 12px; line-height: 1.5; color: var(--mh-dim); grid-column: 1 / -1; }
  .mh-more { grid-column: 1 / -1; color: var(--mh-dim); font-size: 13px; }
  .mh-more summary { cursor: pointer; list-style: none; font: 500 13px/1 var(--mh-mono); color: var(--mh-ink); min-height: 44px; display: flex; align-items: center; }
  .mh-more summary::-webkit-details-marker { display: none; }
  .mh-more summary::before { content: "▸"; color: var(--mh-sky); margin-right: 8px; }
  .mh-more[open] summary::before { content: "▾"; }
  .mh .mh-ro-more { grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 4px; }
  .mh .mh-legend { margin-top: 12px; line-height: 1.55; }
  .mh-cta-phone { display: none; }

  /* ================= phone ================= */
  @media (max-width: 640px) {
    .mh { grid-template-columns: minmax(0, 1fr); padding-inline: 0; }
    .mh-text { padding: 22px var(--mh-gutter) 16px; }
    .mh-eyebrow, .mh-actions, .mh-tiles, .mh-label, .mh-play, .mh-note, .mh-ro .mh-x { display: none; }
    .mh h1 { font-size: clamp(42px, 12.5vw, 56px); }
    .mh .mh-sub { font-size: 20px; margin-top: 10px; }
    .mh-cta-phone { display: grid; gap: 4px; padding: 14px var(--mh-gutter) 0; }
    .mh-cta-phone .mh-primary { width: 100%; min-height: 48px; font-size: 16px; }
    .mh-links { display: flex; justify-content: center; gap: 24px; }
    .mh-links a { color: var(--mh-ink); text-decoration: none; font-size: 15px; font-weight: 500; min-height: 44px; display: inline-flex; align-items: center; }
    .mh-links a:hover { color: var(--mh-sky); }
    .mh-bar { padding: 10px var(--mh-gutter) 4px; border-top: 0; grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .mh-chip { min-height: 40px; }
    .mh-ro { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .mh-ro dd { font-size: 14px; }
  }

  /* ================= tablet ================= */
  @media (min-width: 641px) and (max-width: 1099px) {
    .mh { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); column-gap: 28px; align-items: center; padding-block: 28px 0; }
    .mh-tiles, .mh-note, .mh-cta-phone { display: none; }
    .mh h1 { font-size: clamp(38px, 5.4vw, 64px); }
    .mh .mh-sub { font-size: clamp(20px, 2.6vw, 26px); }
    .mh-actions .mh-btn { padding: 0 14px; }
    .mh-bar { grid-column: 1 / -1; margin-top: 24px; margin-inline: calc(-1 * var(--mh-side)); padding-inline: var(--mh-side);
              grid-template-columns: minmax(0, 1fr) auto; }
    .mh-rigs { grid-column: 1 / -1; }
    .mh-ro { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .mh-ro .mh-x { display: none; }
  }

  /* short landscape phones */
  @media (min-width: 641px) and (max-width: 1099px) and (max-height: 480px) {
    .mh { padding-block: 12px 0; align-items: start; }
    .mh-eyebrow { display: none; }
    .mh h1 { font-size: 40px; }
    .mh .mh-sub { font-size: 18px; margin-top: 8px; }
    .mh-actions { margin-top: 14px; gap: 8px; }
    .mh-bar { margin-top: 12px; }
  }

  /* ================= wide (laptop / desktop) ================= */
  @media (min-width: 1100px) {
    .mh { --mh-side: max(var(--mh-gutter), calc((100vw - 1760px) / 2));
          height: clamp(560px, calc(100svh - var(--sl-nav-height, 3.5rem)), 900px);
          grid-template-columns: minmax(22rem, 36rem) minmax(0, 1fr) auto; grid-template-rows: minmax(0, 1fr) auto;
          column-gap: clamp(20px, 2vw, 40px); }
    .mh-text { grid-column: 1; grid-row: 1; align-self: center; position: relative; z-index: 2; }
    /* the loop is placed by JS over the free area right of ~55 % of the text column (this is the pre-JS fallback) */
    .mh-video { position: absolute; z-index: 1; left: 40%; right: 260px; top: 0; bottom: 90px; }
    .mh-frame { position: absolute; inset: 0; width: auto; aspect-ratio: auto; }
    .mh-main { -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 22%, #000 96%, transparent 100%), linear-gradient(180deg, transparent 0, #000 10%, #000 90%, transparent 100%);
               -webkit-mask-composite: source-in;
               mask-image: linear-gradient(90deg, transparent 0, #000 22%, #000 96%, transparent 100%), linear-gradient(180deg, transparent 0, #000 10%, #000 90%, transparent 100%);
               mask-composite: intersect; }
    .mh-more, .mh-cta-phone, .mh-label, .mh-note { display: none; }
    .mh-tiles { grid-column: 3; grid-row: 1; align-self: center; display: grid; gap: 10px; position: relative; z-index: 2; }
    /* two rows: every recording chip on its own full-width row, readout + Pause below */
    .mh-bar { grid-column: 1 / -1; grid-row: 2; margin-inline: calc(-1 * var(--mh-side)); padding-inline: var(--mh-side); position: relative; z-index: 2;
              grid-template-columns: minmax(0, 1fr) auto; gap: 10px 28px;
              background: linear-gradient(180deg, rgba(5, 7, 10, 0.6), rgba(5, 7, 10, 0.9)); }
    .mh-rigs { grid-column: 1 / -1; }
    .mh-ro { grid-column: 1; grid-template-columns: repeat(6, minmax(0, auto)); justify-content: space-between; }
    .mh-play { grid-column: 2; align-self: center; }
  }
  @media (min-width: 1100px) and (max-width: 1439px) {
    .mh-bar { grid-template-columns: minmax(0, 1fr) auto; column-gap: 18px; }
    .mh-ro { gap: 8px 12px; }
    .mh-ro dt { letter-spacing: 0.04em; font-size: 10px; gap: 5px; }
    .mh-ro dd { font-size: 14px; }
  }
  @media (min-width: 1100px) and (min-height: 880px) {
    .mh-label, .mh-note { display: block; }
    .mh-note { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  }
  @media (min-width: 1100px) and (max-height: 800px) {
    .mh h1 { font-size: 64px; }
    .mh .mh-sub { font-size: 23px; }
    .mh-eyebrow { margin-bottom: 12px; }
    .mh-actions { margin-top: 20px; }
    .mh-actions .mh-btn { min-height: 40px; font-size: 14px; padding: 0 14px; }
    .mh-bar { padding-block: 10px; }
  }
  @media (min-width: 1100px) and (max-height: 680px) { .mh-eyebrow { display: none; } }

  @media (prefers-reduced-motion: reduce) {
    .mh-ro, .mh-tile, .mh-tile figcaption em { transition: none; }
  }
</style>

<script is:inline define:vars={{ V, RIG_DATA: rigs }}>
  (function () {
    function mu(f) { return "/media/hero/" + f + "?v=" + (V[f] || "0"); }
    var RIGS = {}, ORDER = [];
    RIG_DATA.forEach(function (r) { ORDER.push(r.key); RIGS[r.key] = r; });
    var hero = document.querySelector(".mh");
    if (!hero) return;
    var video = document.getElementById("mhVideo");
    var frame = document.getElementById("mhFrame"), videoBox = hero.querySelector(".mh-video");
    var tilesEl = document.getElementById("mhTiles"), stripEl = document.getElementById("mhStrip"), more = document.getElementById("mhMore");
    var textEl = hero.querySelector(".mh-text"), barEl = hero.querySelector(".mh-bar");
    var toggle = document.getElementById("mhPlay"), bigPlay = document.getElementById("mhBigPlay");
    var chips = hero.querySelectorAll(".mh-chip");
    var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var conn = navigator.connection || {};
    var lean = !!conn.saveData || /(^|-)2g$/.test(conn.effectiveType || "");
    var current = ORDER[0], layout = null, userPaused = false, onScreen = true, preloaded = {};
    var LIVE_CYCLE = RIG_DATA[0].live_cycle || 5, POSTER_FRACTION = 0.6, LOOP_S = RIG_DATA[0].duration || 15;
    var sync = [];                 // companion videos that follow the hero clock: {v, k, lat, lastSeek, seekStart}

    function isWide() { return window.innerWidth >= 1100; }
    function heroSrc(key) { return (isWide() && !lean) ? mu("hero_" + key + ".mp4") : mu("hero_" + key + "_960.mp4"); }
    function heroPoster(key) { return isWide() ? mu("hero_" + key + ".jpg") : mu("hero_" + key + "_960.jpg"); }
    function safePlay(v) { var p = v.play(); return (p && p.catch) ? p : Promise.resolve(); }
    function setToggle() { toggle.textContent = video.paused ? "Play" : "Pause"; }

    function makeTile(key, c, small) {
      var li = document.createElement("li");
      var fig = document.createElement("figure"); fig.className = "mh-tile"; fig.style.setProperty("--cam", c[3]);
      var cap = document.createElement("figcaption");
      cap.innerHTML = "<i></i><b>" + c[0] + "</b>" + (small ? "" : "<span>" + c[1] + (c[2] === "rolling" ? " · RS" : "") + "</span><em>in 3-D</em>");
      var v = document.createElement("video");
      v.muted = true; v.playsInline = true; v.preload = "metadata";
      v.setAttribute("muted", ""); v.setAttribute("playsinline", ""); v.setAttribute("aria-hidden", "true");
      v.width = c[4]; v.height = c[5];
      var base = key + "_" + c[0] + (small ? "_240" : "");
      v.poster = mu(base + ".jpg"); v.src = mu(base + ".mp4"); v.dataset.src = mu(base + ".mp4"); v.dataset.cam = c[0];
      fig.appendChild(cap); fig.appendChild(v); li.appendChild(fig);
      return { li: li, v: v };
    }

    function addCompanion(v, k) {
      var s = { v: v, k: k, lat: 0.15, lastSeek: 0, seekStart: 0, lastT: -1, lastAdvance: performance.now(), lastRecover: 0, recoveries: 0 };
      // measure how long a seek really takes on this device, so the next one can aim ahead
      v.addEventListener("seeked", function () {
        if (s.seekStart) { s.lat = Math.min(1.5, 0.5 * s.lat + 0.5 * (performance.now() - s.seekStart) / 1000); s.seekStart = 0; }
      });
      sync.push(s);
    }

    function buildCompanions(key) {
      sync.forEach(function (s) { s.v.pause(); s.v.removeAttribute("src"); s.v.load(); });
      sync = [];
      tilesEl.innerHTML = ""; stripEl.innerHTML = "";
      var cams = RIGS[key].tiles;
      if (isWide()) {
        cams.forEach(function (c, k) { var t = makeTile(key, c, false); tilesEl.appendChild(t.li); addCompanion(t.v, k); });
      } else if (more.open) {
        cams.forEach(function (c, k) { var t = makeTile(key, c, true); stripEl.appendChild(t.li); addCompanion(t.v, k); });
      }
      fit();
    }

    function applyReadout(key) {
      var r = RIGS[key];
      hero.querySelectorAll("[data-k]").forEach(function (el) {
        var val = el.dataset.k === "caption" ? r.caption : r[el.dataset.k];
        if (val != null) el.innerHTML = val;
      });
    }

    // Start the hero and every companion in the same call, so a tap's user gesture covers all of them (iOS),
    // and without seeking: companions were paused together with the hero and are already aligned.
    function play() {
      bigPlay.hidden = true;
      safePlay(video).catch(function () { if (!userPaused) bigPlay.hidden = false; });   // autoplay refused (e.g. iOS Low Power Mode)
      sync.forEach(function (s) { s.v.playbackRate = 1; if (!s.v.ended) safePlay(s.v).catch(function () {}); });
      setToggle();
    }
    function pause() { video.pause(); sync.forEach(function (s) { s.v.pause(); }); setToggle(); }

    // The chip row is a scroller only when the chips do not fit (phones, narrow tablets). When it does
    // scroll, keep the recording that is playing in view: before this, the strip stayed at scrollLeft 0
    // and recordings past the third were faded out or off-screen for the whole cycle.
    var chipBox = document.getElementById("mhChips"), lastChipDrag = -Infinity;
    ["pointerdown", "wheel", "touchstart"].forEach(function (e) {
      chipBox.addEventListener(e, function () { lastChipDrag = performance.now(); }, { passive: true });
    });
    function updateChipOverflow() {
      chipBox.classList.toggle("is-over", chipBox.scrollWidth > chipBox.clientWidth + 2);
      chipBox.classList.toggle("at-end", chipBox.scrollLeft >= chipBox.scrollWidth - chipBox.clientWidth - 2);
    }
    chipBox.addEventListener("scroll", updateChipOverflow, { passive: true });
    function showChip(chip) {
      if (!chipBox.classList.contains("is-over") || !chip) return;
      if (performance.now() - lastChipDrag < 5000) return;          // do not fight a finger on the strip
      var b = chipBox.getBoundingClientRect(), c = chip.getBoundingClientRect();
      var pad = chipBox.classList.contains("at-end") ? 0 : 36;
      if (c.left >= b.left && c.right <= b.right - pad) return;
      chipBox.scrollTo({ left: chipBox.scrollLeft + (c.left - b.left) - (b.width - c.width) / 2, behavior: reduce ? "auto" : "smooth" });
    }

    function select(key, autoplay) {
      if (!RIGS[key]) return;
      current = key;
      chips.forEach(function (c) {
        var on = c.dataset.rig === key;
        c.setAttribute("aria-pressed", on ? "true" : "false");
        if (on) showChip(c);
      });
      var wasPlaying = !video.paused;
      video.poster = heroPoster(key); video.src = heroSrc(key);
      buildCompanions(key);
      if (wasPlaying || autoplay) play();
      var ro = hero.querySelectorAll(".mh-ro");
      if (reduce) applyReadout(key);
      else { ro.forEach(function (d) { d.classList.add("swap"); }); setTimeout(function () { applyReadout(key); ro.forEach(function (d) { d.classList.remove("swap"); }); }, 220); }
    }

    // Keep companions on the hero clock and outline the camera shown in 3-D.
    //  - never start a seek while one is running (a new seek cancels the old one: that was the freeze)
    //  - drift under 0.5 s: nudge playbackRate instead of seeking
    //  - larger drift: one seek aimed ahead by the measured seek latency, at most once per second
    var SEEK_DRIFT = 0.5, SEEK_COOLDOWN = 1000, STALL_MS = 1500, RECOVER_GAP_MS = 3000, MAX_RECOVERIES = 6;

    // Watchdog: a companion that stops advancing while the hero plays (stalled network request, stuck seek,
    // decoder error) is reloaded from a fresh URL and put back on the hero clock. Browsers differ in why a
    // single video element stalls; this recovers from all of them instead of guessing the cause.
    function recover(s, why) {
      var v = s.v, now = performance.now();
      s.recoveries++; s.lastRecover = now; s.lastAdvance = now; s.seekStart = 0; s.lastSeek = now;
      if (window.console) console.info("[openmvis hero] reloading " + (v.dataset.cam || "video") + " (" + why + ", attempt " + s.recoveries + ")");
      v.pause();
      v.src = v.dataset.src + "&r=" + s.recoveries;          // fresh cache entry: sidesteps a locked or broken one
      v.load();
      v.addEventListener("loadedmetadata", function () {
        try { v.currentTime = Math.min((video.duration || LOOP_S) - 0.05, (video.currentTime || 0) + s.lat); } catch (e) {}
        if (!video.paused) safePlay(v).catch(function () {});
      }, { once: true });
    }
    function tick() {
      var d = video.duration || LOOP_S, now = performance.now();
      var atPoster = video.paused && !(video.currentTime > 0);
      var t = atPoster ? POSTER_FRACTION * d : (video.currentTime || 0);
      var n = RIGS[current].tiles.length, liveK = Math.floor(t / LIVE_CYCLE) % n;
      var heroHeld = video.paused || video.readyState < 3;     // paused, or buffering: companions wait for the hero
      sync.forEach(function (s) {
        var v = s.v;
        if (heroHeld || atPoster) { s.lastAdvance = now; s.lastT = v.currentTime; }
        else if (v.currentTime > s.lastT + 0.01 || v.ended) { s.lastAdvance = now; s.lastT = v.currentTime; }
        else if ((v.error || now - s.lastAdvance > STALL_MS) && now - s.lastRecover > RECOVER_GAP_MS && s.recoveries < MAX_RECOVERIES && t < (video.duration || LOOP_S) - 1) {
          recover(s, v.error ? "error " + v.error.code : "stalled"); return;
        }
        if (heroHeld) { if (!v.paused) v.pause(); }
        else if (v.paused && !v.ended && !v.seeking) safePlay(v).catch(function () {});
        if (!atPoster && !heroHeld && !video.ended && !v.seeking && v.readyState >= 2) {
          var drift = (v.currentTime || 0) - t;
          if (Math.abs(drift) > SEEK_DRIFT && now - s.lastSeek > SEEK_COOLDOWN && t < d - 1) {
            s.lastSeek = now; s.seekStart = now; v.playbackRate = 1;
            v.currentTime = Math.min(d - 0.05, t + s.lat);
          } else if (Math.abs(drift) > 0.04) {
            v.playbackRate = Math.max(0.8, Math.min(1.25, 1 - drift));
          } else if (v.playbackRate !== 1) {
            v.playbackRate = 1;
          }
        }
        var tile = v.closest(".mh-tile"); if (tile) tile.classList.toggle("live", s.k === liveK);
      });
      if (!video.paused && video.currentTime > 0.6 * d) preloadNext();
      requestAnimationFrame(tick);
    }

    // warm the next recording once the current one is 60 % through
    function preloadNext() {
      var nk = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length];
      if (preloaded[nk] || nk === current) return; preloaded[nk] = true;
      var srcs = [heroSrc(nk)].concat(isWide() ? RIGS[nk].tiles.map(function (c) { return mu(nk + "_" + c[0] + ".mp4"); }) : []);
      // download into the HTTP cache (no hidden <video> players that could lock the same cache entries as the visible ones)
      srcs.forEach(function (src) { if (window.fetch) fetch(src, { priority: "low" }).then(function (r) { return r.arrayBuffer(); }).catch(function () {}); });
    }

    // wide layout: tile column width from the available height; the loop fills the free area right of the text
    function fit() {
      if (!isWide()) { videoBox.style.cssText = ""; tilesEl.style.cssText = ""; return; }
      var cams = RIGS[current].tiles, cols = cams.length >= 4 ? 2 : 1, rows = Math.ceil(cams.length / cols);
      var H = hero.clientHeight, barH = barEl.offsetHeight, pad = 24;
      var avail = H - barH - 2 * pad, aspectSum = 0;
      for (var r = 0; r < rows; r++) { var m = 0; for (var c = 0; c < cols; c++) { var cam = cams[r * cols + c]; if (cam) m = Math.max(m, cam[5] / cam[4]); } aspectSum += m; }
      var colW = (avail - rows * 24 - (rows - 1) * 10) / aspectSum;
      colW = Math.max(110, Math.min(colW, 240, (window.innerWidth * 0.24 - (cols - 1) * 10) / cols));
      tilesEl.style.gridTemplateColumns = "repeat(" + cols + ", " + Math.floor(colW) + "px)";
      var hb = hero.getBoundingClientRect(), tb = textEl.getBoundingClientRect(), lb = tilesEl.getBoundingClientRect();
      var right = (lb.width ? lb.left : hb.right - 40) - hb.left - 24;
      var minLeft = tb.left - hb.left + tb.width * 0.55;
      var h = H - barH - 2 * pad, w = h * 16 / 9;
      if (right - w < minLeft) { w = right - minLeft; h = w * 9 / 16; }
      var left = right - w, top = (H - barH - h) / 2;
      videoBox.style.cssText = "left:" + Math.round(left) + "px;top:" + Math.round(top) + "px;width:" + Math.round(w) + "px;height:" + Math.round(h) + "px;right:auto;bottom:auto";
    }

    function onLayoutChange() {
      updateChipOverflow();
      var l = isWide() ? "wide" : "narrow";
      if (l === layout) { fit(); return; }
      layout = l;
      var wasPlaying = !video.paused, t = video.currentTime || 0;
      video.poster = heroPoster(current);
      var src = heroSrc(current);
      if (video.getAttribute("src") !== src) {
        video.src = src;
        if (t > 0) video.addEventListener("loadedmetadata", function once() { video.removeEventListener("loadedmetadata", once); try { video.currentTime = t; } catch (e) {} });
      }
      buildCompanions(current);
      if (wasPlaying) play();
    }

    chips.forEach(function (c) { c.addEventListener("click", function () { select(c.dataset.rig); }); });
    toggle.addEventListener("click", function () { if (video.paused) { userPaused = false; play(); } else { userPaused = true; pause(); } });
    bigPlay.addEventListener("click", function (e) { e.stopPropagation(); userPaused = false; play(); });
    frame.addEventListener("click", function () { if (video.paused) { userPaused = false; play(); } else { userPaused = true; pause(); } });
    frame.addEventListener("dblclick", function (e) { e.preventDefault(); });
    video.addEventListener("ended", function () { select(ORDER[(ORDER.indexOf(current) + 1) % ORDER.length], true); });
    video.addEventListener("play", setToggle);
    video.addEventListener("pause", function () { sync.forEach(function (s) { s.v.pause(); }); setToggle(); });
    more.addEventListener("toggle", function () {
      if (isWide()) return;
      buildCompanions(current);
      sync.forEach(function (s) { s.v.addEventListener("loadedmetadata", function () { try { s.v.currentTime = video.currentTime || 0; } catch (e) {} }, { once: true }); });
      if (!video.paused) play();
    });

    function autoResume() { if (onScreen && !document.hidden && !userPaused && !reduce && !lean && video.paused && !video.ended) play(); }
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (es) { onScreen = es[0].isIntersecting; if (!onScreen && !video.paused) video.pause(); else autoResume(); }, { threshold: 0.15 }).observe(hero);
    }
    document.addEventListener("visibilitychange", function () { if (document.hidden) { if (!video.paused) video.pause(); } else autoResume(); });
    var rt; window.addEventListener("resize", function () { clearTimeout(rt); rt = setTimeout(onLayoutChange, 120); });

    if (/[?&]debug=1/.test(location.search)) {
      var dbg = document.createElement("pre");
      dbg.style.cssText = "position:fixed;left:8px;bottom:8px;z-index:9999;margin:0;padding:8px 10px;background:rgba(0,0,0,.85);color:#9f9;font:11px/1.35 ui-monospace,monospace;border-radius:6px;pointer-events:none;max-width:96vw;white-space:pre";
      document.body.appendChild(dbg);
      setInterval(function () {
        var f = function (v) { return (v.currentTime || 0).toFixed(2) + (v.paused ? " P" : " >") + (v.seeking ? " S" : "") + " rs" + v.readyState + " ns" + v.networkState + (v.error ? " E" + v.error.code : "") + " x" + v.playbackRate.toFixed(2); };
        dbg.textContent = "rig " + current + "  hero " + f(video) + "\n" + sync.map(function (s) { return (s.v.dataset.cam || "?") + "  " + f(s.v) + "  lat " + s.lat.toFixed(2) + "  rec " + s.recoveries; }).join("\n");
      }, 250);
    }

    onLayoutChange();
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
    if (!reduce && !lean) play(); else { setToggle(); if (lean) bigPlay.hidden = false; }
    requestAnimationFrame(tick);
  })();
</script>
