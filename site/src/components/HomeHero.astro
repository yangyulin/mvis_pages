---
// Homepage hero (overrides Starlight's Hero, which only renders on pages with a
// `hero` frontmatter block — i.e. the landing page).
//
// A 15 s real-time pass of each MVIS calibration listed in rigs.json, cycled (rig flying its recovered trajectory,
// frustums, board corners in the colour of the camera shown in 3-D), one synced
// detection tile per camera, and a readout of values MVIS recovered from that
// recording. Media: public/media/hero/ — rendered by openmvis-internal
// demo_video/render_hero.py + render_hero_tiles.py.
//
// Cache busting: the media keep fixed file names, so every URL carries a short content
// hash (?v=...) computed at build time. A re-render changes the hash, and browsers fetch
// the new video instead of replaying their cached copy.
import { readdirSync, readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';

// resolved from the project root (the bundled module lives elsewhere at build time)
const MEDIA_DIR = `${process.cwd()}/public/media/hero/`;
const V = {};
for (const f of readdirSync(MEDIA_DIR)) {
  V[f] = createHash('sha1').update(readFileSync(MEDIA_DIR + f)).digest('hex').slice(0, 10);
}
const u = (f) => `/media/hero/${f}?v=${V[f] ?? '0'}`;

// rigs.json is written by openmvis-internal demo_video/build_site_media.py: cycle order,
// chip labels, captions, readout values and per-camera tiles for every recording.
const { rigs } = JSON.parse(readFileSync(MEDIA_DIR + 'rigs.json', 'utf8'));
const first = rigs[0];
const countWords = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const cycleLabel = `Cycling through ${countWords[rigs.length] ?? rigs.length} recordings`;
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,500..800&family=JetBrains+Mono:wght@400;500&display=swap" />

<section class="mh" aria-label="Open MVIS">
  <video class="mh-video" id="mhVideo" muted playsinline preload="auto" poster={u(`hero_${first.key}.jpg`)} aria-hidden="true">
    <source src={u(`hero_${first.key}.mp4`)} type="video/mp4" />
  </video>

  <div class="mh-stage">
    <div class="mh-lede">
      <div class="mh-eyebrow"><b>v0.1</b><span>Toolbox + public benchmark</span></div>
      <h1>OpenMVIS</h1>
      <p class="mh-sub">Open-source <em>multi-visual-inertial</em> <span class="mh-nw">system calibration</span></p>
      <div class="mh-actions">
        <a class="mh-btn mh-primary" href="/getting-started/quickstart/">Get started
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9m-3.5-3.5L12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
        <a class="mh-btn mh-ghost" href="/benchmark/leaderboard/">Browse the leaderboard</a>
        <a class="mh-btn mh-ghost" href="/examples/">See the examples</a>
      </div>
    </div>
    <ul class="mh-tiles" id="mhTiles" aria-label="Detections in each camera"></ul>
  </div>

  <div class="mh-readout">
    <div class="mh-rigs">
      <span class="mh-label" id="mhRigsLabel">{cycleLabel}</span>
      <div class="mh-chips" role="group" aria-labelledby="mhRigsLabel">
        {rigs.map((r, i) => (
          <button class="mh-chip" id={`mh-rig-${r.key}`} type="button" data-rig={r.key} aria-pressed={i === 0 ? 'true' : 'false'}>{r.chip}</button>
        ))}
      </div>
    </div>
    <dl class="mh-ro" id="mhReadout" aria-live="polite">
      <div><dt>Sensors</dt><dd data-k="sensors" set:html={first.sensors} /></div>
      <div><dt>Window</dt><dd data-k="window" set:html={first.window} /></div>
      <div><dt>Reproj median</dt><dd data-k="rms" set:html={first.rms} /></div>
      <div><dt>Base cam offset</dt><dd data-k="td" set:html={first.td} /></div>
      <div><dt data-k="xlabel" set:html={first.xlabel} /><dd data-k="xval" set:html={first.xval} /></div>
      <div><dt>Corners / frame</dt><dd data-k="corners" set:html={first.corners} /></div>
    </dl>
    <p class="mh-note">
      <span id="mhCaption">{first.caption}</span>
      <span class="mh-legend">Each camera has its own colour. The outlined tile is the camera shown in 3-D, and the board corners it detects take that colour. In the tiles, coloured circles are detections and white crosses are reprojections.</span>
      <button class="mh-play" id="mhPlay" type="button" aria-controls="mhVideo">Pause</button>
    </p>
  </div>
</section>

<style is:global>
  html:has(.mh), html:has(.mh) body { overflow-x: clip; }

  .mh {
    --mh-night: #05070a;
    --mh-ink: #eef3f8;
    --mh-dim: #9aa9ba;
    --mh-rule: rgba(148, 163, 184, 0.22);
    --mh-sky: #38bdf8;
    --mh-amber: #ff9f1c;
    --mh-display: "Archivo", "Helvetica Neue", Arial, sans-serif;
    --mh-mono: "JetBrains Mono", var(--sl-font-mono, ui-monospace), monospace;
    --mh-gutter: clamp(16px, 4vw, 48px);
    --mh-tw: 11rem;
    --mh-reserve: calc(var(--mh-tw) * var(--mh-cols, 1) + (var(--mh-cols, 1) - 1) * 10px + 2 * var(--mh-gutter));

    position: relative;
    isolation: isolate;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-top: -1.5rem;
    min-height: clamp(560px, calc(84svh - var(--sl-nav-height, 3.5rem)), 800px);
    background: var(--mh-night);
    color: var(--mh-ink);
    display: grid;
    grid-template-rows: 1fr auto;
    overflow: hidden;
  }
  .mh-video {
    position: absolute; inset: 0 var(--mh-reserve) 0 28%;
    width: auto; height: 100%;
    object-fit: cover; z-index: -2; background: var(--mh-night);
  }
  .mh::before {
    content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      linear-gradient(90deg, rgba(5,7,10,1) 0%, rgba(5,7,10,0.96) 30%, rgba(5,7,10,0.35) 44%, rgba(5,7,10,0) 56%),
      linear-gradient(180deg, rgba(5,7,10,0.55) 0%, rgba(5,7,10,0) 14%, rgba(5,7,10,0) 58%, rgba(5,7,10,0.9) 100%);
  }
  .mh-stage > *, .mh-readout > * { min-width: 0; }
  .mh h1 { border-bottom: 0; padding-bottom: 0; }
  .mh-stage {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 32px;
    align-items: center; padding: 36px var(--mh-gutter) 28px;
  }
  .mh-lede { max-width: 44rem; }
  .mh-eyebrow {
    font: 500 12px/1 var(--mh-mono); letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--mh-dim); display: flex; gap: 12px; align-items: center; margin-bottom: 22px;
  }
  .mh-eyebrow b { color: var(--mh-sky); font-weight: 500; }
  .mh h1 {
    margin: 0; color: var(--mh-ink);
    font: 800 clamp(52px, 8.4vw, 112px)/0.92 var(--mh-display);
    font-stretch: 120%; letter-spacing: -0.035em;
  }
  .mh-sub {
    margin: 18px 0 0; max-width: 42rem; color: #c9d4e0;
    font: 600 clamp(22px, 2.6vw, 34px)/1.15 var(--mh-display); font-stretch: 108%; letter-spacing: -0.012em;
  }
  .mh-sub em { font-style: normal; color: var(--mh-sky); white-space: nowrap; }
  .mh-nw { white-space: nowrap; }
  .mh-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .mh-btn {
    display: inline-flex; align-items: center; gap: 8px; padding: 11px 18px; border-radius: 7px;
    font-weight: 600; font-size: 15px; line-height: 1; text-decoration: none; border: 1px solid transparent;
  }
  .mh-primary { background: var(--mh-sky); color: #04111c; }
  .mh-primary:hover { background: #7dd3fc; color: #04111c; }
  .mh-ghost { color: var(--mh-ink); border-color: var(--mh-rule); background: rgba(5,7,10,0.35); }
  .mh-ghost:hover { border-color: var(--mh-dim); color: #fff; }
  .mh-btn svg { width: 16px; height: 16px; }
  .mh :focus-visible { outline: 2px solid var(--mh-sky); outline-offset: 3px; border-radius: 3px; }

  .mh-tiles { display: grid; grid-template-columns: repeat(var(--mh-cols, 1), var(--mh-tw)); gap: 10px; align-content: center; margin: 0; padding: 0; list-style: none; }
  .mh-tiles li { margin: 0; }
  .mh-tile { margin: 0; border: 1px solid var(--mh-rule); border-radius: 7px; overflow: hidden; background: rgba(5,7,10,0.72); transition: border-color .3s ease, box-shadow .3s ease; }
  .mh-tile figcaption { display: flex; align-items: center; gap: 7px; padding: 6px 8px; font: 500 11px/1.2 var(--mh-mono); color: var(--mh-dim); white-space: nowrap; overflow: hidden; }
  .mh-tile figcaption i { width: 7px; height: 7px; border-radius: 2px; background: var(--cam); flex: none; }
  .mh-tile figcaption b { color: var(--mh-ink); font-weight: 500; }
  .mh-tile figcaption span { overflow: hidden; text-overflow: ellipsis; }
  .mh-tile figcaption em { margin-left: auto; font-style: normal; font-size: 9.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--cam); opacity: 0; transition: opacity .3s ease; }
  .mh-tile video { display: block; width: 100%; height: auto; max-width: 100%; background: var(--mh-night); }
  .mh-tile.live { border-color: var(--cam); box-shadow: 0 0 0 1px var(--cam), 0 8px 28px rgba(0,0,0,.45); }
  .mh-tile.live figcaption em { opacity: 1; }

  .mh-readout {
    border-top: 1px solid var(--mh-rule);
    background: linear-gradient(180deg, rgba(5,7,10,0.2), rgba(5,7,10,0.75));
    backdrop-filter: blur(6px);
    padding: 16px var(--mh-gutter) 18px;
    display: grid; grid-template-columns: minmax(0, auto) minmax(0, 1fr); gap: 18px 40px; align-items: end;
  }
  .mh-rigs { display: grid; gap: 10px; max-width: 36rem; }
  .mh-label, .mh-ro dt { font: 500 10.5px/1 var(--mh-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--mh-dim); }
  .mh-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .mh-chip { font-size: 13px; font-weight: 500; line-height: 1; color: var(--mh-dim); background: transparent; border: 1px solid var(--mh-rule); border-radius: 999px; padding: 8px 13px; cursor: pointer; }
  .mh-chip:hover { color: var(--mh-ink); border-color: var(--mh-dim); }
  .mh-chip[aria-pressed="true"] { color: #04111c; background: var(--mh-ink); border-color: var(--mh-ink); }
  .mh-ro { margin: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 14px 22px; transition: opacity .25s ease; }
  .mh-ro.swap { opacity: 0; }
  .mh-ro div { min-width: 0; }
  .mh-ro dt { display: flex; align-items: center; gap: 7px; }
  .mh-ro dt::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--mh-amber); flex: none; }
  .mh-ro dd { margin: 8px 0 0; font: 500 15px/1.2 var(--mh-mono); font-variant-numeric: tabular-nums; color: var(--mh-ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mh-ro dd small { color: var(--mh-dim); font-size: 12px; }
  .mh-note { grid-column: 1 / -1; margin: 0; font-size: 12px; line-height: 1.5; color: var(--mh-dim); display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .mh-legend { flex: 1 1 28rem; }
  .mh-play { font: 500 12px/1 var(--mh-mono); color: var(--mh-dim); background: none; border: 0; padding: 0; cursor: pointer; letter-spacing: .06em; }
  .mh-play:hover { color: var(--mh-ink); }

  @media (max-width: 1180px) {
    .mh { --mh-reserve: 0px; }
    .mh-video { inset: 0 0 0 20%; }
    .mh-ro { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .mh-readout { grid-template-columns: minmax(0, 1fr); }
    .mh-stage > *, .mh-readout > * { min-width: 0; }
  .mh h1 { border-bottom: 0; padding-bottom: 0; }
  .mh-stage { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .mh-tiles { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 10.5rem; overflow-x: auto; padding-bottom: 6px; align-items: start; }
  }
  @media (max-width: 860px) {
    .mh-video { inset: 0; }
    .mh::before { background: linear-gradient(180deg, rgba(5,7,10,0.7) 0%, rgba(5,7,10,0.55) 45%, rgba(5,7,10,0.92) 100%); }
  }
  @media (max-width: 520px) {
    .mh-ro { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mh-ro, .mh-tile, .mh-tile figcaption em { transition: none; }
  }
</style>

<script is:inline define:vars={{ V, RIG_DATA: rigs }}>
  (function () {
    var RIGS = {}, TILES = {}, ORDER = [];
    RIG_DATA.forEach(function (r) {
      ORDER.push(r.key);
      TILES[r.key] = r.tiles;
      RIGS[r.key] = { src: mu("hero_" + r.key + ".mp4"), poster: mu("hero_" + r.key + ".jpg"), sensors: r.sensors, window: r.window,
                      rms: r.rms, td: r.td, xlabel: r.xlabel, xval: r.xval, corners: r.corners, caption: r.caption,
                      cycle: r.live_cycle, duration: r.duration };
    });
    function mu(f) { return "/media/hero/" + f + "?v=" + (V[f] || "0"); }
    var LIVE_CYCLE = RIG_DATA[0].live_cycle || 5.0;
    var current = ORDER[0];
    var hero = document.querySelector(".mh");
    if (!hero) return;
    var video = document.getElementById("mhVideo");
    var readout = document.getElementById("mhReadout");
    var caption = document.getElementById("mhCaption");
    var toggle = document.getElementById("mhPlay");
    var tilesEl = document.getElementById("mhTiles");
    var chips = hero.querySelectorAll(".mh-chip");
    var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var tileVids = [];

    function safePlay(v) { var p = v.play(); if (p && p.catch) p.catch(function () {}); }
    function play() { safePlay(video); tileVids.forEach(function (v) { v.currentTime = video.currentTime; safePlay(v); }); }
    function setToggle() { toggle.textContent = video.paused ? "Play" : "Pause"; }

    function buildTiles(key) {
      var cams = TILES[key];
      tilesEl.innerHTML = ""; tileVids = [];
      hero.style.setProperty("--mh-cols", cams.length >= 4 ? 2 : 1);
      cams.forEach(function (c) {
        var li = document.createElement("li");
        var fig = document.createElement("figure"); fig.className = "mh-tile"; fig.style.setProperty("--cam", c[3]);
        var cap = document.createElement("figcaption");
        cap.innerHTML = "<i></i><b>" + c[0] + "</b><span>" + c[1] + (c[2] === "rolling" ? " · RS" : "") + "</span><em>in 3-D</em>";
        var v = document.createElement("video");
        v.muted = true; v.loop = false; v.playsInline = true; v.preload = "auto";
        v.setAttribute("muted", ""); v.setAttribute("playsinline", ""); v.setAttribute("aria-hidden", "true");
        v.width = c[4]; v.height = c[5];
        v.poster = mu(key + "_" + c[0] + ".jpg");
        v.src = mu(key + "_" + c[0] + ".mp4");
        fig.appendChild(cap); fig.appendChild(v); li.appendChild(fig); tilesEl.appendChild(li);
        tileVids.push(v);
      });
    }

    // Before playback starts (or with reduced motion) the hero and tiles show their posters,
    // which are rendered at 60 % of the loop; outline the camera shown at that moment.
    var POSTER_FRACTION = 0.6, LOOP_S = 15;
    function tick() {
      var d = video.duration || LOOP_S, n = tileVids.length;
      var atPoster = video.paused && !(video.currentTime > 0);
      var t = atPoster ? POSTER_FRACTION * d : (video.currentTime || 0);
      tileVids.forEach(function (v, k) {
        if (!video.paused && v.paused) safePlay(v);
        if (video.paused && !v.paused) v.pause();
        var dt = Math.abs((v.currentTime || 0) - t);
        if (!atPoster && !video.ended && dt > 0.12 && dt < d - 0.3 && v.readyState >= 2) v.currentTime = t;
        v.parentNode.classList.toggle("live", n > 0 && k === Math.floor(t / LIVE_CYCLE) % n);
      });
      if (!video.paused && video.currentTime > 0.6 * d) preloadNext(current);
      requestAnimationFrame(tick);
    }

    // Warm the cache for the next recording only when the current one is 60 % through and
    // still playing, so a visitor downloads at most the recording on screen plus the next one.
    var preloaded = {};
    function preloadNext(key) {
      var nk = ORDER[(ORDER.indexOf(key) + 1) % ORDER.length];
      if (preloaded[nk] || nk === key) return;
      preloaded[nk] = true;
      [RIGS[nk].src].concat(TILES[nk].map(function (c) { return mu(nk + "_" + c[0] + ".mp4"); })).forEach(function (src) {
        var p = document.createElement("video"); p.muted = true; p.preload = "auto"; p.src = src;
      });
    }

    function select(key, autoplay) {
      var r = RIGS[key]; if (!r) return;
      current = key;
      chips.forEach(function (c) { c.setAttribute("aria-pressed", c.dataset.rig === key ? "true" : "false"); });
      var wasPaused = video.paused;
      video.poster = r.poster; video.src = r.src;
      buildTiles(key);
      if (!wasPaused || autoplay) play();
      var apply = function () {
        readout.querySelectorAll("[data-k]").forEach(function (el) { if (r[el.dataset.k] != null) el.innerHTML = r[el.dataset.k]; });
        caption.textContent = r.caption; readout.classList.remove("swap"); setToggle();
      };
      if (reduce) apply(); else { readout.classList.add("swap"); setTimeout(apply, 220); }
    }

    chips.forEach(function (c) { c.addEventListener("click", function () { select(c.dataset.rig); }); });
    toggle.addEventListener("click", function () { if (video.paused) play(); else video.pause(); });
    // one pass of a recording, then the next one
    video.addEventListener("ended", function () { select(ORDER[(ORDER.indexOf(current) + 1) % ORDER.length], true); });
    video.addEventListener("play", setToggle); video.addEventListener("pause", setToggle);

    // Data saver / very slow connections: show the posters, play only on request.
    var conn = navigator.connection || {};
    var lean = !!conn.saveData || /(^|-)2g$/.test(conn.effectiveType || "");
    var userPaused = false;
    toggle.addEventListener("click", function () { userPaused = video.paused; });   // runs after the play/pause handler

    // Stop playing (and downloading the next recordings) while the hero is off screen or the tab is hidden.
    var onScreen = true;
    function autoResume() { if (onScreen && !document.hidden && !userPaused && !reduce && !lean && video.paused && !video.ended) play(); }
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (es) {
        onScreen = es[0].isIntersecting;
        if (!onScreen && !video.paused) video.pause(); else autoResume();
      }, { threshold: 0.15 }).observe(hero);
    }
    document.addEventListener("visibilitychange", function () { if (document.hidden) { if (!video.paused) video.pause(); } else autoResume(); });

    buildTiles(current);
    if (!reduce && !lean) play();
    setToggle();
    requestAnimationFrame(tick);
  })();
</script>
