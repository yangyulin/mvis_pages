---
// Sensor overview: one photo card per sensor. Card data is generated by export_sensor.py.
const all = import.meta.glob('../data/sensors/*.json', { eager: true }) as Record<string, { default: any }>;
interface Props { slugs: string[] }
const { slugs } = Astro.props;
const cards = slugs.map((slug) => {
  const s = all[`../data/sensors/${slug}.json`]?.default;
  if (!s) throw new Error(`no sensor ${slug}`);
  return s.card;
});
---

<ul class="not-content sg" role="list">
  {cards.map((c) => (
    <li class="sg-card">
      <a href={c.href}>
        <img src={c.image} alt={c.alt} width="800" height="533" loading="lazy" decoding="async" />
        <div class="sg-body">
          <span class="sg-maker">{c.maker}</span>
          <span class="sg-name">{c.title}</span>
          <span class="sg-type">{c.type}</span>
          <span class="sg-tags">{c.tags.map((t: string) => <span>{t}</span>)}</span>
        </div>
      </a>
    </li>
  ))}
</ul>

<style>
  .sg { list-style: none; margin: 1.5rem 0 2rem; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16.5rem), 1fr)); }
  .sg-card { margin: 0; min-width: 0; }
  .sg-card a { display: flex; flex-direction: column; height: 100%; color: inherit; text-decoration: none; border: 1px solid var(--sl-color-hairline); border-radius: 0.6rem; overflow: hidden; background: var(--sl-color-bg); transition: border-color 0.15s, transform 0.15s; }
  .sg-card a:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  .sg-card img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; background: #fff; border-bottom: 1px solid var(--sl-color-hairline); }
  .sg-body { display: flex; flex-direction: column; gap: 0.25rem; padding: 0.8rem 0.9rem 0.9rem; flex: 1; min-width: 0; }
  .sg-maker { min-height: 1.3em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 0.75rem; font-weight: 600; color: var(--sl-color-gray-3); line-height: 1.3; }
  .sg-name { font-size: 1.1rem; font-weight: 700; color: var(--sl-color-white); line-height: 1.25; }
  .sg-type { font-size: 0.85rem; line-height: 1.4; color: var(--sl-color-text); }
  .sg-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: auto; padding-top: 0.5rem; }
  .sg-tags span { font-size: 0.72rem; font-weight: 600; line-height: 1.3; padding: 0.12rem 0.5rem; border-radius: 99px; background: var(--sl-color-bg-nav); color: var(--sl-color-text); }
  /* Hover only where a pointer can hover: on a phone it would stay on after a tap. */
  @media (hover: hover) {
    .sg-card a:hover { border-color: var(--sl-color-accent); transform: translateY(-2px); }
    .sg-card a:hover .sg-name { color: var(--sl-color-text-accent); }
  }
  /* Phones: two columns, whole 3:2 photo on top. The type line waits for the sensor's page, so names and tags stay readable. */
  @media (max-width: 34rem) {
    .sg { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
    .sg-body { padding: 0.55rem 0.6rem 0.65rem; gap: 0.15rem; }
    .sg-maker { font-size: 0.7rem; }
    .sg-name { font-size: 0.95rem; }
    .sg-type { display: none; }
    .sg-tags { gap: 0.25rem; padding-top: 0.4rem; }
    .sg-tags span { font-size: 0.68rem; padding: 0.1rem 0.4rem; }
  }
  @media (prefers-reduced-motion: reduce) { .sg-card a { transition: none; } .sg-card a:hover { transform: none; } }
</style>
