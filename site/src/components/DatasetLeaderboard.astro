---
// board.json and board.css are generated from the Calibench leaderboard app, so this page and the Space show the
// same rows: site/scripts/export_board.py (python/mvis_site/space.py runs the Space's renderer).
import board from '../data/leaderboard/board.json';
import '../data/leaderboard/board.css';

interface Props { id: string }
const { id } = Astro.props;
const html = (board.datasets as Record<string, string>)[id];
if (!html) throw new Error(`no leaderboard dataset ${id}`);
---

<div class="not-content lb-wrap" set:html={html} />

<style>
  .lb-wrap { margin-block: 1rem 2rem; }
</style>
