---
// Twin verdict table for the calibration-motion guide. Data: public/data/calib-motion/<set>/twin_verdicts.json, written
// by mira scripts/mvis/calib_motion_demo/gate.py and copied by site/scripts/export_calib_motion.py (schema there).
// set = 'v4' (AprilGrid guide motions, public/data/calib-motion/v4/), 'v3' (chessboard twin, v3/) or 'real' (the AprilGrid
// example from real_takes/ and the chessboard example from real_chess/, each judged on its own board's twin).
// Verdicts use `passed` and the raw σ ratio.
interface Props { set?: 'v4' | 'v3' | 'real' }
const { set = 'v4' } = Astro.props;
const refName = set === 'v3' ? 'the 80 s reference motion on the chessboard twin'
  : set === 'real' ? "the 80 s reference motion on the twin of the take's board (AprilGrid or chessboard)"
  : 'the 80 s reference motion on the AprilGrid twin';
const firstName = { v4: 'Guide motion, 60 s', v3: 'Chessboard version, 60 s', real: 'AprilGrid example' }[set];
---

<div class="not-content cmv" data-set={set}>
  <p class="cmv-note" data-role="note">Loading the twin verdicts…</p>
  <div class="cmv-wrap">
    <table class="cmv-table" data-role="table"></table>
  </div>
  <p class="cmv-legend">
    ✓ every parameter in the group passes. ✗ names the failing parameters, the conditions they fail
    (<b>a</b> a solve failed or its reprojection error is not plausible, <b>b</b> noise-free error too large, <b>c</b> error above 3σ on 2 of the 3 noise seeds or above 4σ on one, <b>d</b> σ above 3× the reference)
    and the worst σ against the reference, {refName}. Under <b>good</b>: the largest σ ratio over the 22 parameters
    and the frame count. σ is compared with the reference's directly, whatever the length of the motion, so a short
    take passes if its σ stays within 3× of what 80 s of the reference motion gives.
    Click a motion to play it. Hover a cell for the numbers.
  </p>
  <details class="cmv-detail" data-role="detail">
    <summary>All 22 parameters for <b data-role="dname">{firstName}</b> (follows the player)</summary>
    <div class="cmv-wrap">
      <table class="cmv-table cmv-dtable" data-role="dtable"></table>
    </div>
    <p class="cmv-legend">R_CI is the log(R) rotation vector of the camera-IMU rotation error, per camera axis, in mrad.
      * = per-axis error not recorded in that run; the error norm is used for each axis (a conservative bound).</p>
  </details>
</div>

<style>
  .cmv { margin-block: 1rem 2rem; font-size: 0.85rem; }
  .cmv-note {
    padding: 0.5rem 0.75rem; border-radius: 0.4rem; border: 1px solid var(--sl-color-orange, #f59e0b);
    background: var(--sl-color-orange-low, rgba(245, 158, 11, 0.12)); color: var(--sl-color-white);
  }
  .cmv-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .cmv-table { border-collapse: collapse; width: 100%; min-width: 46rem; }
  .cmv-dtable { min-width: 40rem; }
  .cmv-table th, .cmv-table :global(td), .cmv-table :global(th) {
    border-bottom: 1px solid var(--sl-color-gray-5); padding: 0.35rem 0.45rem; text-align: left; vertical-align: top;
  }
  .cmv-table :global(thead th) { font-weight: 600; color: var(--sl-color-white); white-space: nowrap; }
  .cmv-table :global(td.ok) { color: #16a34a; }
  .cmv-table :global(td.bad) { color: #dc2626; }
  .cmv-table :global(td.bad span) { color: var(--sl-color-gray-3); font-size: 0.78rem; }
  .cmv-table :global(tr.bad th), .cmv-table :global(tr.bad td) { color: #dc2626; }
  .cmv-table :global(td.ok span) { color: var(--sl-color-gray-3); font-size: 0.78rem; }
  :global(:root[data-theme='dark']) .cmv-table :global(td.ok) { color: #4ade80; }
  :global(:root[data-theme='dark']) .cmv-table :global(td.bad),
  :global(:root[data-theme='dark']) .cmv-table :global(tr.bad th),
  :global(:root[data-theme='dark']) .cmv-table :global(tr.bad td) { color: #f87171; }
  .cmv-table :global(.cm-link) {
    font: inherit; font-weight: 600; text-align: left; padding: 0; border: 0; background: none; cursor: pointer;
    color: var(--sl-color-text-accent); text-decoration: underline; text-underline-offset: 2px;
  }
  .cmv-legend { color: var(--sl-color-gray-3); font-size: 0.78rem; margin-top: 0.5rem; }
  .cmv-detail { margin-top: 0.75rem; }
  .cmv-detail summary { cursor: pointer; }
</style>

<script>
  import { mountVerdicts } from '../scripts/calib-motion.js';
  document.querySelectorAll('.cmv[data-set]').forEach((el) => mountVerdicts(el));
</script>
