---
// One part of an example page (/benchmark/examples/<slug>/). The MDX is generated by site/scripts/export_examples.py
// (python/mvis_site/export_examples.py) and lists the parts, so the seven step headings reach the table of contents.
// Uses the sensor pages' stylesheet and script; the result part carries the page's only map (one #sp-data per page).
import '../data/sensors/sensor.css';

const all = import.meta.glob('../data/examples/*.json', { eager: true }) as Record<string, { default: any }>;
interface Props { example: string; part: string }
const { example, part } = Astro.props;
const x = all[`../data/examples/${example}.json`]?.default;
if (!x) throw new Error(`no example ${example}`);
const html = x.parts[part];
if (html === undefined) throw new Error(`no part ${part} for example ${example}`);
const data = part === 'result' && x.rigs.length ? JSON.stringify({ rigs: x.rigs, procs: x.procs, plotly: x.plotly }).replace(/</g, '\\u003c') : null;
---

<div class="not-content sp ex" set:html={html} />
{data && <script type="application/json" id="sp-data" set:html={data} />}
<script src="../scripts/sensor-page.js"></script>

<style is:global>
  .sp.ex .ex-head { display: grid; grid-template-columns: minmax(0, 22rem) minmax(0, 1fr); gap: 1.25rem; align-items: start; }
  .sp.ex .ex-photo { margin: 0; }
  .sp.ex .ex-photo img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 0.6rem; background: #fff; border: 1px solid var(--line); }
  .sp.ex .ex-photo figcaption { font-size: 0.78rem; color: var(--muted); margin-top: 0.35rem; }
  .sp.ex .ex-photo figcaption a { color: inherit; }
  .sp.ex .ex-head .chips { margin: 0 0 0.75rem; }
  .sp.ex .ex-links { display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; margin: 0.75rem 0 0; }
  .sp.ex .ex-callout { border: 1px solid var(--line); border-left: 3px solid var(--accent); border-radius: 0.4rem; padding: 0.75rem 1rem; background: var(--soft); }
  .sp.ex .ex-callout p { margin: 0; }
  .sp.ex .ex-kv { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 0.35rem 1rem; margin: 0; }
  .sp.ex .ex-kv dt { color: var(--muted); font-weight: 600; }
  .sp.ex .ex-kv dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  .sp.ex table.num { font-size: 0.85rem; }
  .sp.ex table.num th { text-align: left; white-space: nowrap; }
  @media (max-width: 44rem) {
    .sp.ex .ex-head { grid-template-columns: minmax(0, 1fr); gap: 0.9rem; }
  }
</style>
