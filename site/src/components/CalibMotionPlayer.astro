---
// Calibration-motion player (guides/calibration-motion), made to be followed: Now panel, 3D view from behind the
// operator, camera cards (drawn board and detected corners, never a camera image), transport, move chips, sensor traces.
// Code: src/scripts/calib-motion.js. Data: public/data/calib-motion/{v4,v3,real_takes,real_chess}/ (anim v1 with segment
// beats; the real examples also <variant>.cams.json, loaded when opened), written by site/scripts/export_calib_motion.py.
// mode = 'main' (guide motion, chessboard version) or 'real' (the AprilGrid and the chessboard example).
interface Props { mode?: 'main' | 'real' }
const { mode = 'main' } = Astro.props;
const main = mode === 'main';
---

<div class="not-content cm" id={`cm-player-${mode}`} data-mode={mode} data-base="/data/calib-motion/" tabindex="0"
  aria-label={main ? 'Calibration motion player' : 'Real examples player'}>
  <div class="cm-chips cm-variants" data-role="variants" role="group" aria-label="Motion"></div>
  <p class="cm-caption" data-role="caption"></p>
  {!main && <p class="cm-diff" data-role="diff"></p>}

  <div class="cm-prac" data-role="pbadge" hidden>
    <span data-role="ptext" aria-live="polite"></span>
    <button type="button" class="cm-pracexit" data-role="pexit">Exit practice</button>
  </div>
  <section class="cm-now" data-role="now" aria-label="Now">
    <div class="cm-now-top">
      <span class="cm-now-title"><i class="cm-now-sw" data-role="sw"></i><span data-role="title" aria-live="polite"></span></span>
      <span class="cm-now-right"><span class="cm-now-left" data-role="left"></span><button type="button" class="cm-primary cm-nowplay" data-role="play2" aria-label="Play"><span class="cm-ic" aria-hidden="true">▶&#xFE0E;</span><span class="cm-pl">Play</span></button></span>
    </div>
    <div class="cm-now-cue" data-role="cue"></div>
    <div class="cm-now-beat" data-role="beat">&nbsp;</div>
    <div class="cm-now-bar"><i data-role="bar"></i><span data-role="ticks"></span></div>
    <div class="cm-now-next" data-role="next"></div>
  </section>
  <details class="cm-more" data-role="more" hidden><summary>More detail</summary><p data-role="moretext"></p></details>

  <div class="cm-stage">
    <div class="cm-view3d">
      <canvas data-role="c3d" aria-label="3D view: the board, the camera's path in move colours and the camera now"></canvas>
      <div class="cm-readout" data-role="readout"></div>
      <div class="cm-views" data-role="views" role="group" aria-label="View">
        <button type="button" data-view="op" title="From behind the operator: screen left is your left">Operator</button>
        <button type="button" data-view="3d" title="Drag to turn, double-click to reset">3D</button>
        <button type="button" data-view="top">Top</button>
        <button type="button" data-view="side" title="From the operator's right">Side</button>
      </div>
      <div class="cm-count" data-role="count" hidden aria-live="assertive"><b data-role="countn"></b><span data-role="ready"></span></div>
      <div class="cm-over cm-start" data-role="start">
        <button type="button" class="cm-bigplay" data-role="startbtn">
          <span class="cm-bigic" aria-hidden="true"><svg viewBox="0 0 24 24" width="40" height="40"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg></span>
          <span class="cm-biglab" data-role="startlab">{main ? 'Start the guided motion · 60 s' : 'Play the real recording'}</span>
        </button>
        <p class="cm-steps3" data-role="steps3">{main
          ? <><span><b>1</b> Watch it once</span><span><b>2</b> Practise each move</span><span><b>3</b> Follow along with your rig</span></>
          : <span>Watch the path and the corners each camera detected</span>}</p>
      </div>
      <div class="cm-over cm-end" data-role="end" hidden>
        <p class="cm-endq">Done. Did your board reach every corner?</p>
        <div class="cm-endcov"><canvas data-role="endcov" aria-label="Image coverage at the end of the take"></canvas><span data-role="endpct"></span></div>
        <div class="cm-endbtns">
          <button type="button" class="cm-primary" data-role="again"><span class="cm-ic" aria-hidden="true">↺</span>Watch again</button>
          {main && <button type="button" class="cm-second" data-role="hard">Practise the hardest move</button>}
          <a class="cm-second" href="#step-by-step">Read the steps</a>
        </div>
      </div>
    </div>
    <div class="cm-cardcol">
      <div class="cm-tabs" data-role="tabs" role="group" aria-label="Camera"></div>
      <div class="cm-cards" data-role="cards"></div>
    </div>
  </div>

  <div class="cm-transport">
    <div class="cm-tmain">
      <button type="button" class="cm-primary cm-play" data-role="play" aria-label="Play"><span class="cm-ic" aria-hidden="true">▶&#xFE0E;</span><span class="cm-pl">Play</span></button>
      <input class="cm-scrub" type="range" data-role="scrub" min="0" max="60" step="0.01" value="0" aria-label="Time" />
      <span class="cm-time" data-role="time">0.0 s</span>
    </div>
    <div class="cm-tsub">
    <button type="button" class="cm-step" data-role="prev" aria-label="Previous move">◀&#xFE0E; Move</button>
    <button type="button" class="cm-step" data-role="nextmove" aria-label="Next move">Move ▶&#xFE0E;</button>
    <span class="cm-speeds" data-role="speeds" role="group" aria-label="Speed"></span>
    <span class="cm-toggles">
      <button type="button" data-role="repeat" aria-pressed="false">Repeat this move</button>
      <button type="button" data-role="axes" aria-pressed="false">Axes</button>
      <button type="button" data-role="img" aria-pressed="true">Camera view on rig</button>
      <button type="button" class="cm-camfs" data-role="camfs" aria-pressed="false">Camera</button>
      <button type="button" data-role="fs" aria-pressed="false">Full screen</button>
    </span>
    </div>
  </div>
  <p class="cm-keys">Space play · ←/→ move · R repeat · F full screen{main && ' · Esc exit practice'}</p>

  <div class="cm-chips cm-segchips" data-role="segchips" role="group" aria-label={main ? 'Jump to a move, or practise it' : 'Jump to a move'}></div>

  <details class="cm-traces" data-role="traces">
    <summary>Sensor traces (gyro, accelerometer)</summary>
    <canvas class="cm-imu" data-role="cimu" aria-label="Gyro and accelerometer traces; click to jump there"></canvas>
    <div class="cm-legend"><span><i class="cm-sw cm-x"></i>IMU x</span><span><i class="cm-sw cm-y"></i>y</span><span><i class="cm-sw cm-z"></i>z</span></div>
    {main && <p class="cm-imunote">The fine wobble is natural hand shake; do not add it on purpose.</p>}
  </details>
  <p class="cm-status" data-role="status"></p>
  {!main && <table class="cm-table" data-role="table"></table>}
</div>

<style is:global>
  .cm {
    --cm-x: #d1382c; --cm-y: #2f9e44; --cm-z: #1c6fd1; --cm-g: #7c3aed; --cm-t: #d97706;
    --cm-board: #f8fafc; --cm-tag: #0f172a; --cm-cov: 2, 132, 199;
    --cm-s-lr: #0d9488; --cm-s-ud: #db2777; --cm-s-bf: #8b5e34; --cm-s-loop: #7c7c00; --cm-s-rest: #94a3b8;
    --cm-now-bg: #f1f5f9; --cm-now-fg: var(--sl-color-white); --cm-corner: #16a34a; --cm-ghost: var(--sl-color-gray-3);
    --cm-cam0: #2563eb; --cm-cam1: #dc2626; --cm-cam2: #16a34a;
    --cm-text: var(--sl-color-gray-3);
    /* primary button: 5.9:1 white on sky-700 in light, 8:1 slate-900 on sky-400 in dark */
    --cm-pri-bg: #0369a1; --cm-pri-fg: #fff;
    margin-block: 1rem 2rem;
    font-size: 0.9rem;
    outline: none;
  }
  :root[data-theme='dark'] .cm {
    --cm-x: #f87171; --cm-y: #4ade80; --cm-z: #60a5fa; --cm-g: #c4b5fd; --cm-t: #fbbf24;
    --cm-board: #e2e8f0; --cm-tag: #0f172a; --cm-cov: 56, 189, 248;
    --cm-s-lr: #2dd4bf; --cm-s-ud: #f472b6; --cm-s-bf: #d4a373; --cm-s-loop: #d9d65c; --cm-s-rest: #64748b;
    --cm-now-bg: var(--sl-color-gray-6); --cm-corner: #4ade80;
    --cm-pri-bg: #38bdf8; --cm-pri-fg: #0f172a;
  }
  .cm :is(button, a, input):focus-visible { outline: 3px solid var(--sl-color-accent); outline-offset: 2px; }
  .cm:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 4px; border-radius: 0.5rem; }
  .cm button { font: inherit; cursor: pointer; }
  .cm-chips { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .cm-chips button, .cm-toggles button, .cm-speeds button, .cm-views button, .cm-tabs button, .cm-step {
    font-size: 0.82rem; line-height: 1.2; padding: 0.35rem 0.65rem; border-radius: 999px; min-height: 2.1rem;
    border: 1px solid var(--sl-color-gray-5); background: var(--sl-color-bg); color: var(--sl-color-gray-2);
  }
  .cm-chips button:hover, .cm-toggles button:hover, .cm-speeds button:hover, .cm-views button:hover, .cm-tabs button:hover, .cm-step:hover {
    border-color: var(--sl-color-accent); color: var(--sl-color-white);
  }
  .cm [aria-pressed='true'] { background: var(--cm-pri-bg); border-color: var(--cm-pri-bg); color: var(--cm-pri-fg); }
  .cm-dot { display: inline-block; width: 0.5rem; height: 0.5rem; border-radius: 50%; margin-right: 0.35rem; }
  .cm-dot.pass { background: #22c55e; } .cm-dot.fail { background: #ef4444; } .cm-dot.none { background: var(--sl-color-gray-4); }
  .cm-caption { margin: 0.5rem 0 0; color: var(--sl-color-gray-2); }
  .cm-diff { margin: 0.2rem 0 0; color: var(--sl-color-gray-3); font-size: 0.85rem; }

  /* Now panel: the one place to look while moving */
  .cm-now {
    margin: 0.6rem 0 0; padding: 0.6rem 0.9rem 0.55rem; border-radius: 0.6rem; background: var(--cm-now-bg); color: var(--cm-now-fg);
    border-left: 4px solid var(--sl-color-accent); min-height: 7.5rem; display: grid; gap: 0.2rem;
    grid-template-rows: auto calc(2 * 1.2 * clamp(1.15rem, 1rem + 0.8vw, 1.6rem)) auto auto auto;
  }
  .cm-now-top { display: flex; justify-content: space-between; align-items: baseline; gap: 0.75rem; }
  .cm-now-title { font-weight: 600; font-size: 1rem; display: inline-flex; align-items: center; gap: 0.45rem; min-width: 0; }
  .cm-now-sw { width: 0.85rem; height: 0.85rem; border-radius: 0.2rem; flex: none; }
  .cm-now-right { display: inline-flex; align-items: center; gap: 0.5rem; }
  /* the one primary button (Play / Pause / Again): filled, 44 px at least, the same in the Now panel and the transport */
  .cm .cm-primary {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem; font-weight: 700; font-size: 1.05rem;
    min-height: 2.75rem; min-width: 6.5rem; padding: 0.3rem 1rem; border-radius: 0.5rem; text-decoration: none;
    border: 1px solid var(--cm-pri-bg); background: var(--cm-pri-bg); color: var(--cm-pri-fg);
  }
  .cm .cm-primary:hover { filter: brightness(1.08); }
  .cm-ic { font-size: 0.9em; width: 1.1em; text-align: center; }
  .cm .cm-second {
    display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0.3rem 0.9rem; border-radius: 0.5rem; font-weight: 600;
    border: 1px solid var(--sl-color-gray-4); background: var(--sl-color-bg); color: var(--sl-color-white); text-decoration: none;
  }
  .cm .cm-second:hover { border-color: var(--sl-color-accent); }
  .cm-nowplay { flex: none; }
  .cm-now-top { align-items: center; }
  .cm-now-left { font-size: 1.25rem; font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .cm-now-cue { font-size: clamp(1.15rem, 1rem + 0.8vw, 1.6rem); font-weight: 600; line-height: 1.2; align-self: center; overflow: hidden; }
  .cm-now-beat { color: var(--sl-color-gray-2); font-variant-numeric: tabular-nums; }
  .cm[data-mode='real'] .cm-now-beat { display: none; }
  .cm-now.cm-ready .cm-now-cue { color: var(--sl-color-text-accent); }
  .cm-now-bar { position: relative; height: 8px; border-radius: 4px; background: var(--sl-color-gray-5); overflow: hidden; }
  .cm-now-bar > i { position: absolute; inset: 0 auto 0 0; border-radius: 4px; }
  .cm-now-bar > span i { position: absolute; top: 0; bottom: 0; width: 2px; margin-left: -1px; background: var(--sl-color-bg); opacity: 0.9; }
  .cm-now-next {
    font-size: 0.88rem; color: var(--sl-color-gray-2); padding: 0.15rem 0.45rem; border: 1px solid transparent; border-radius: 0.35rem;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-inline: -0.45rem;
  }
  .cm-now-next.soon { border-color: var(--sl-color-accent); color: var(--cm-now-fg); font-weight: 600; }
  .cm-more { margin: 0.3rem 0 0; font-size: 0.85rem; color: var(--sl-color-gray-2); }
  .cm-more summary { cursor: pointer; color: var(--sl-color-gray-3); }
  .cm-more p { margin: 0.2rem 0 0; }

  /* stage: 3D view and camera cards */
  .cm-stage { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 0.75rem; margin-top: 0.6rem; align-items: start; }
  .cm canvas { display: block; width: 100%; border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; background: var(--sl-color-bg-nav, var(--sl-color-black)); }
  .cm-view3d { position: relative; min-width: 0; }
  .cm-view3d canvas { aspect-ratio: 4 / 3; min-height: 340px; touch-action: pan-y; cursor: grab; }
  .cm-readout {
    position: absolute; left: 0.5rem; top: 0.5rem; max-width: calc(100% - 16rem); font-size: 0.78rem; padding: 0.15rem 0.45rem; border-radius: 0.3rem;
    background: color-mix(in srgb, var(--sl-color-bg) 82%, transparent); color: var(--sl-color-gray-2); pointer-events: none;
  }
  .cm-views { position: absolute; z-index: 3; right: 0.5rem; top: 0.5rem; display: flex; gap: 0.25rem; flex-wrap: wrap; justify-content: flex-end; }
  .cm-views button { min-height: 1.9rem; padding: 0.25rem 0.55rem; }
  .cm-count {
    position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5rem;
    pointer-events: none; color: var(--sl-color-white); background: color-mix(in srgb, var(--sl-color-bg) 55%, transparent);
    border-radius: 0.5rem; text-align: center; padding: 1rem;
  }
  .cm-count b { font-size: 5rem; font-weight: 700; line-height: 1; }
  .cm-count span { font-size: 1.15rem; font-weight: 600; max-width: 24rem; }
  .cm-count[hidden] { display: none; }
  /* start and end screens over the 3D view: the whole view is the button */
  .cm-over {
    position: absolute; inset: 0; z-index: 2; display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 0.8rem; padding: 1rem; text-align: center; border-radius: 0.5rem;
    background: color-mix(in srgb, var(--sl-color-bg) 72%, transparent); color: var(--sl-color-white);
  }
  .cm-over[hidden] { display: none; }
  .cm-start { cursor: pointer; }
  .cm-end { background: color-mix(in srgb, var(--sl-color-bg) 88%, transparent); }
  .cm .cm-bigplay {
    display: flex; flex-direction: column; align-items: center; gap: 0.7rem; padding: 0.5rem 1rem; border: 0; background: none;
    color: var(--sl-color-white); border-radius: 0.75rem;
  }
  .cm-bigic {
    display: grid; place-items: center; width: 5.5rem; height: 5.5rem; border-radius: 50%; padding-left: 0.3rem;
    background: var(--cm-pri-bg); color: var(--cm-pri-fg); box-shadow: 0 6px 18px -6px rgba(0, 0, 0, 0.45); transition: transform 0.15s;
  }
  .cm-bigplay:hover .cm-bigic, .cm-start:hover .cm-bigic { transform: scale(1.06); }
  .cm-biglab { font-size: 1.3rem; font-weight: 700; }
  .cm-steps3 { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.3rem 1rem; margin: 0; color: var(--sl-color-gray-2); font-size: 0.95rem; }
  .cm-steps3 b {
    display: inline-grid; place-items: center; width: 1.35rem; height: 1.35rem; margin-right: 0.3rem; border-radius: 50%;
    font-size: 0.8rem; border: 1px solid var(--sl-color-gray-3); color: var(--sl-color-white);
  }
  .cm-endq { margin: 0; font-size: 1.3rem; font-weight: 700; }
  .cm-endcov { display: flex; flex-direction: column; align-items: center; gap: 0.3rem; margin: 0; color: var(--sl-color-gray-2); }
  .cm-view3d .cm-endcov canvas { width: auto; height: min(8rem, 22vh); min-height: 0; max-width: 16rem; cursor: default; }
  .cm-over { overflow: hidden; }
  .cm-endbtns { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; margin: 0; }
  .cm-cardcol { min-width: 0; }
  .cm-tabs { display: none; gap: 0.3rem; margin-bottom: 0.4rem; }
  .cm-cards { display: grid; gap: 0.5rem; grid-template-columns: minmax(0, 1fr); }
  /* real examples: the selected camera large (view | coverage), the others as small thumbnails to click */
  .cm-multi .cm-cards { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .cm-multi .cm-card[aria-current='true'] { grid-column: 1 / -1; order: -1; }
  .cm-multi .cm-pair canvas { width: min(100%, calc(var(--cm-h, 15rem) * var(--ar))); justify-self: center; }
  .cm-multi .cm-card:not([aria-current='true']) .cm-pair { grid-template-columns: minmax(0, 1fr); --cm-h: 5.5rem; }
  .cm-multi .cm-card:not([aria-current='true']) .cm-pair canvas + canvas { display: none; }
  .cm-card:not([aria-current='true']) .cm-key, .cm-multi .cm-card:not([aria-current='true']) .cm-tag { display: none; }
  .cm-key span { color: var(--sl-color-accent); font-weight: 600; }
  .cm-card { border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; padding: 0.35rem 0.45rem 0.3rem; cursor: pointer; }
  .cm-card[aria-current='true'] { border-color: var(--sl-color-accent); }
  .cm-card b { display: flex; align-items: center; gap: 0.35rem; font-size: 0.8rem; color: var(--sl-color-white); }
  .cm-card b i { width: 0.6rem; height: 0.6rem; border-radius: 50%; }
  .cm-tag { font-weight: 400; font-size: 0.7rem; color: var(--cm-text); margin-left: auto; }
  .cm-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 0.35rem; margin-top: 0.25rem; align-items: start; }
  .cm-pair canvas { border-radius: 0.3rem; }
  .cm-card small { display: block; font-size: 0.74rem; color: var(--cm-text); margin-top: 0.2rem; font-variant-numeric: tabular-nums; }
  /* the per-frame note: always one line of fixed height (ellipsis when narrow), so the cards never change height */
  .cm-card small.cm-note { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.35; height: 1.35em; }

  /* transport: on a desktop it sticks to the bottom of the window while the player is on screen, so Play, the move
     steps and the scrubber stay at hand under the Now panel and the 3D view */
  .cm-transport { display: flex; flex-direction: column; gap: 0.4rem; margin: 0.7rem 0 0; }
  .cm-tmain { display: flex; align-items: center; gap: 0.75rem; }
  .cm-tsub { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.6rem; }
  .cm-tsub button { font-size: 0.78rem !important; min-height: 1.9rem !important; padding: 0.2rem 0.55rem !important; color: var(--sl-color-gray-2); }
  @media (min-width: 40.0625rem) {
    .cm-transport {
      position: sticky; bottom: 0; z-index: 4; padding: 0.45rem 0; background: var(--sl-color-bg);
      border-top: 1px solid var(--sl-color-gray-6); box-shadow: 0 -6px 10px -8px rgba(0, 0, 0, 0.3);
    }
    .cm-fs .cm-transport { position: static; box-shadow: none; }
  }
  /* practise mode: a badge over the Now panel, with its way out */
  .cm-prac {
    display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; flex-wrap: wrap; margin: 0.6rem 0 0;
    padding: 0.35rem 0.4rem 0.35rem 0.8rem; border-radius: 0.5rem; font-weight: 600;
    background: color-mix(in srgb, var(--sl-color-accent) 16%, var(--sl-color-bg)); border: 1px solid var(--sl-color-accent); color: var(--sl-color-white);
  }
  .cm-prac[hidden] { display: none; }
  .cm .cm-pracexit {
    min-height: 2.75rem; padding: 0.25rem 0.8rem; border-radius: 0.45rem; border: 1px solid var(--sl-color-gray-3);
    background: var(--sl-color-bg); color: var(--sl-color-white); font-weight: 600;
  }
  .cm-segchip { display: inline-flex; }
  .cm-segchip > button:first-child { border-start-end-radius: 0; border-end-end-radius: 0; }
  .cm .cm-segchips .cm-pbtn {
    border-start-start-radius: 0; border-end-start-radius: 0; margin-left: -1px; font-weight: 600; color: var(--cm-pri-bg);
  }
  .cm .cm-segchips .cm-pbtn[aria-pressed='true'] { color: var(--cm-pri-fg); }
  .cm-step { border-radius: 0.45rem; }
  .cm-scrub {
    flex: 1 1 12rem; min-width: 8rem; height: 1.4rem; margin: 0; appearance: none; -webkit-appearance: none; background: transparent; cursor: pointer;
  }
  .cm-scrub::-webkit-slider-runnable-track { height: 8px; border-radius: 4px; background: var(--cm-bands, var(--sl-color-gray-5)); }
  .cm-scrub::-moz-range-track { height: 8px; border-radius: 4px; background: var(--cm-bands, var(--sl-color-gray-5)); }
  .cm-scrub::-webkit-slider-thumb {
    -webkit-appearance: none; width: 18px; height: 18px; margin-top: -5px; border-radius: 50%;
    background: var(--sl-color-white); border: 2px solid var(--sl-color-bg); box-shadow: 0 0 0 1px var(--sl-color-gray-3);
  }
  .cm-scrub::-moz-range-thumb { width: 16px; height: 16px; border-radius: 50%; background: var(--sl-color-white); border: 2px solid var(--sl-color-bg); }
