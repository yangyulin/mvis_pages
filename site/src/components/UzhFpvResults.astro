---
// The same table as the leaderboard page, made by the leaderboard's own renderer from this study's results:
// scripts/mvis/datacard_results/uzh_site.py in the mira repo. Not part of the leaderboard batch.
import results from '../data/leaderboard/uzh_fpv.json';
import '../data/leaderboard/board.css';
---

