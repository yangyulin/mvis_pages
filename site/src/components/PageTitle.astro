---
// Sensor pages with a `sensor` frontmatter key get the datasheet header in place of the plain title.
// Styles come from SensorPage in the MDX body, so other pages load nothing extra.
import Default from '@astrojs/starlight/components/PageTitle.astro';

const all = import.meta.glob('../data/sensors/*.json', { eager: true }) as Record<string, { default: any }>;
const sensor = (Astro.locals.starlightRoute.entry.data as any).sensor;
const html = sensor ? all[`../data/sensors/${sensor}.json`]?.default.parts.header : null;
---

{html ? <div class="not-content sp" set:html={html} /> : <Default />}
