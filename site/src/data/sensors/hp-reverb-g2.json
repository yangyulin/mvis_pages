insics free, t_ga on, seeded from the camera-only round. Batch of 2026-11-02.</li></ul>"}, "rigs": [{"cams": [{"name": "cam0", "p": [-51.85, 13.32, 5.13], "r": [-0.34521, 0.07461, 1.53842], "intr": [269.92155, 270.19743, 322.50684, 229.16024, 0.0828, -0.04144, 0.22653, -0.12781], "size": [640, 480], "td": -1.25, "reproj": 0.284, "fov": {"h": 118.12824855251837, "v": 94.16963517467383, "turn": 71.82}, "readout": -6.931109132366037e-10}, {"name": "cam1", "p": [56.63, 14.08, 5.36], "r": [-0.07429, 0.3448, 1.59444], "intr": [268.78513, 268.74004, 323.76266, 236.96656, 0.07842, -0.03462, 0.21848, -0.12403], "size": [640, 480], "td": -1.254, "reproj": 0.336, "fov": {"h": 118.66659948704275, "v": 94.7404355987579, "turn": 72.0}, "readout": -4.3754018692261933e-10}], "ref": null, "imu": {"Dw": [1.00177, 1.00185, 1.00044], "Da": [1.00781, 1.01209, 1.00967], "tga": 2.5405}, "baseline": 108.48290602671004, "label": "MGC imucalib01"}], "procs": ["/media/sensors/hp-reverb-g2/process0.json"], "plotly": "/media/sensors/plotly-3.0.1.min.js", "card": {"title": "HP Reverb G2", "href": "/benchmark/sensors/hp-reverb-g2/", "sensors": "4 tracking cameras + IMU @ 1 kHz", "format": "EuRoC mav0", "shows": "A consumer headset, from public data"}}