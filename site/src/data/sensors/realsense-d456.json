=\"middle\" style=\"fill:var(--x);font-weight:700\">x</text><text class=\"axis\" x=\"155.7\" y=\"136.6\" text-anchor=\"middle\" style=\"fill:var(--z);font-weight:700\">z</text><text class=\"dim\" x=\"106.2\" y=\"139.6\" text-anchor=\"middle\">cam0</text><text class=\"dim\" x=\"313.7\" y=\"139.1\" text-anchor=\"middle\">cam1</text><text class=\"dim\" x=\"235.0\" y=\"139.1\" text-anchor=\"middle\">cam2</text><text class=\"dim\" x=\"130.1\" y=\"154.7\" text-anchor=\"middle\">35.5 mm</text><text class=\"dim\" x=\"239.8\" y=\"159.2\" text-anchor=\"middle\">71.1 mm</text><path class=dl d=\"M106.2 191.3V201.3M313.7 191.3V201.3M106.2 197.3H313.7\"/><text class=\"dim\" x=\"210.0\" y=\"213.3\" text-anchor=\"middle\">baseline 94.4 mm</text><line class=sc x1=\"362.1\" y1=\"243.3\" x2=\"406\" y2=\"243.3\"/><text class=sct x=\"384.0\" y=\"237.3\" text-anchor=\"middle\">20 mm</text></svg></figure><figure class=rig-view><figcaption>From the front</figcaption><svg viewBox=\"0 0 420 136\" role=\"img\" aria-label=\"From the front: solved camera and IMU layout, to scale\"><circle class=cam cx=\"313.7\" cy=\"59.8\" r=\"9\" fill=\"none\" stroke=\"var(--accent)\" stroke-width=\"3\"/><circle cx=\"313.7\" cy=\"59.8\" r=\"3\" fill=\"var(--accent)\"/><circle class=cam cx=\"106.3\" cy=\"59.8\" r=\"9\" fill=\"none\" stroke=\"var(--ghost)\" stroke-width=\"3\"/><circle cx=\"106.3\" cy=\"59.8\" r=\"3\" fill=\"var(--ghost)\"/><circle class=cam cx=\"184.9\" cy=\"59.3\" r=\"9\" fill=\"none\" stroke=\"var(--c2)\" stroke-width=\"3\"/><circle cx=\"184.9\" cy=\"59.3\" r=\"3\" fill=\"var(--c2)\"/><rect class=imu x=\"249.0\" y=\"39.0\" width=\"10\" height=\"10\" rx=\"1.5\"/><line x1=\"254.0\" y1=\"44.0\" x2=\"233.2\" y2=\"43.9\" stroke=\"var(--x)\" stroke-width=\"2\"/><line x1=\"254.0\" y1=\"44.0\" x2=\"253.8\" y2=\"64.7\" stroke=\"var(--y)\" stroke-width=\"2\"/><text class=\"axis\" x=\"223.2\" y=\"47.8\" text-anchor=\"middle\" style=\"fill:var(--x);font-weight:700\">x</text><text class=\"axis\" x=\"253.8\" y=\"78.7\" text-anchor=\"middle\" style=\"fill:var(--y);font-weight:700\">y</text><text class=\"dim\" x=\"313.7\" y=\"83.8\" text-anchor=\"middle\">cam0</text><text class=\"dim\" x=\"106.3\" y=\"83.8\" text-anchor=\"middle\">cam1</text><text class=\"dim\" x=\"184.9\" y=\"83.3\" text-anchor=\"middle\">cam2</text><line class=sc x1=\"362.1\" y1=\"123.8\" x2=\"406\" y2=\"123.8\"/><text class=sct x=\"384.0\" y=\"117.8\" text-anchor=\"middle\">20 mm</text></svg></figure></div></div><div class=\"scroll rig-table\"><table class=num><thead><tr><th>Camera</th><th>Lever x, y, z (mm)</th><th>Distance (mm)</th><th>log(R) (rad)</th><th>td (ms)</th><th>Field of view</th></tr></thead><tbody><tr><th>cam0</th><td>−27.0, +6.8, +22.0</td><td>35.5</td><td>[+0.007, +0.011, +0.006]</td><td>+7.08</td><td>89° × 58°</td></tr><tr><th>cam1</th><td>+67.4, +7.4, +21.3</td><td>71.1</td><td>[+0.007, +0.009, +0.006]</td><td>+7.08</td><td>89° × 58°</td></tr><tr><th>cam2</th><td>+31.6, +7.0, +21.7</td><td>38.9</td><td>[+0.009, +0.008, +0.005]</td><td>+6.03</td><td>90° × 59°</td></tr></tbody></table></div></div><p class=rig-note>Solved by MVIS. Lever arms (camera–IMU position offsets) are in the IMU frame. Rotation is log(R), camera in the IMU frame.</p>", "detail": "<details class=fold id=\"lens\"><summary>Lens <span>Calibrated field of view</span></summary><div><div class=v data-v=\"0\"><p>Calibrated field of view, horizontal × vertical. cam0: 89° × 58°, corners reach 47° from the axis · cam1: 89° × 58°, corners reach 47° from the axis · cam2: 90° × 59°, corners reach 48° from the axis</p><div class=chart><svg viewBox=\"0 0 560 260\" role=\"img\" aria-label=\"Image radius against ray angle for each camera\"><line class=g x1=54.0 x2=54.0 y1=12 y2=220 /><text x=54.0 y=236 text-anchor=middle>0°</text><line class=g x1=136.3 x2=136.3 y1=12 y2=220 /><text x=136.3 y=236 text-anchor=middle>15°</text><line class=g x1=218.7 x2=218.7 y1=12 y2=220 /><text x=218.7 y=236 text-anchor=middle>30°</text><line class